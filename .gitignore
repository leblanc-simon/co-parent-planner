# Monorepo — règles transverses. Chaque sous-projet a aussi son propre .gitignore.

# OS / éditeurs
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.code-workspace

# Outillage local Claude Code (config machine, non partagée)
.claude/

# Secrets / environnement local (ne jamais committer)
.env.local
.env.*.local
*.local.php
/infra/secrets/

# Clés (JWT, chiffrement) — générées localement, jamais committées
*.pem
backend/config/jwt/*.pem

# Identités de signature iOS / App Store Connect (Lot 9) — vivent chiffrées dans le dépôt match
# dédié, JAMAIS dans le dépôt applicatif. Filet transverse (couvre mobile/ios, le poste mainteneur…).
*.p8
*.p12
*.cer
*.mobileprovision
AuthKey_*.p8

# Logs / temporaire
*.log
/tmp/
.scratchpad/

# Couverture / rapports
coverage/
.phpunit.result.cache
.php-cs-fixer.cache
.phpstan.cache
