{% extends 'app/shell.html.twig' %}
{% block title %}Échanges · CoParentPlanner{% endblock %}
{% set nav_active = 'echanges' %}

{% block main %}
<header class="main__header">
    <div>
        <div class="eyebrow">Coordination</div>
        <h1>Échanges</h1>
    </div>
</header>

{% if not canView %}
    <section class="card"><p class="empty-state">Vous n'avez pas accès aux échanges de cette famille.</p></section>
{% else %}
{# `unread-id` : l'échange ouvert et encore non lu, que le contrôleur marquera lu après affichage.
   Le marquage est un POST déclenché par le navigateur, jamais un effet de bord du GET — sinon le
   préchargement au survol d'un lien ferait tomber les pastilles sans que rien n'ait été lu (X5). #}
<div data-controller="exchanges" data-exchanges-family-id-value="{{ family.id }}"
     data-exchanges-unread-id-value="{{ selected is defined and selected and selected.hasUnread ? selected.id : '' }}">
    <p class="form-error" data-exchanges-target="error" role="alert" hidden></p>
    <p class="form-success" data-exchanges-target="notice" role="status" aria-live="polite" hidden></p>

    {# Abonnement temps réel : liste (badge) + détail ouvert (fil, options, statut) → refresh Turbo.
       `<turbo-mercure-stream-source>` (UX Turbo) est le seul élément qui honore `private` et
       transmet le cookie d'abonnement au hub — cf. `garde.html.twig` (revue 2026-08 C2). #}
    <turbo-mercure-stream-source private data-controller="realtime" src="{{ mercureHub }}?topic={{ listTopic|url_encode }}{% if detailTopic %}&topic={{ detailTopic|url_encode }}{% endif %}"></turbo-mercure-stream-source>

    <div class="exchanges__layout">
        {# ---- Master : liste ---- #}
        <aside class="exchanges__list">
            <div class="agenda-filters">
                <a class="agenda-chip {{ statusFilter == '' ? 'is-active' }}" href="{{ path('app_echanges') }}">Tous</a>
                <a class="agenda-chip {{ statusFilter == 'open' ? 'is-active' }}" href="{{ path('app_echanges', { status: 'open' }) }}">Ouverts</a>
                <a class="agenda-chip {{ statusFilter == 'decided' ? 'is-active' }}" href="{{ path('app_echanges', { status: 'decided' }) }}">Décidés</a>
            </div>

            {% if canEdit %}
            <details class="create-panel card">
                <summary class="create-panel__cta">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                    Nouvel échange
                </summary>
                <form data-action="submit->exchanges#createExchange" class="exchange-form">
                    <div class="field">
                        <label for="e-type">Type</label>
                        <select id="e-type" name="type" data-exchanges-target="type" data-action="change->exchanges#toggleType">
                            <option value="discussion">Discussion</option>
                            <option value="decision">Décision</option>
                        </select>
                    </div>
                    <div class="field"><label for="e-title">Titre</label><input id="e-title" name="title" required maxlength="200"></div>
                    <div class="field"><label for="e-body">Message d'introduction</label><textarea id="e-body" name="body" rows="2"></textarea></div>
                    <div class="grid-2">
                        <div class="field">
                            <label for="e-child">Concerne</label>
                            <select id="e-child" name="childId">
                                <option value="">Toute la famille</option>
                                {% for c in children %}<option value="{{ c.id }}">{{ c.firstName }}</option>{% endfor %}
                            </select>
                        </div>
                        <div class="field"><label for="e-deadline">Échéance (optionnelle)</label><input id="e-deadline" name="deadline" type="date"></div>
                    </div>
                    <div class="exchange-options" data-exchanges-target="options" hidden>
                        <div class="eyebrow">Options (au moins deux)</div>
                        <div data-exchanges-target="optionsRows">
                            <div class="exchange-option-row"><input name="optionLabel[]" placeholder="Libellé de l'option" maxlength="200"><input name="optionSub[]" placeholder="Précision (optionnel)" maxlength="255"></div>
                            <div class="exchange-option-row"><input name="optionLabel[]" placeholder="Libellé de l'option" maxlength="200"><input name="optionSub[]" placeholder="Précision (optionnel)" maxlength="255"></div>
                        </div>
                        <button class="btn btn--ghost" type="button" data-action="exchanges#addOption">+ Option</button>
                    </div>
                    <button class="btn btn--primary" type="submit">Ouvrir l'échange</button>
                </form>
            </details>
            {% endif %}

            {% for ex in exchanges %}
                {# Le non-lu se dit deux fois : en couleur (pastille) ET en mots — un marqueur
                   purement chromatique n'existe pas pour qui ne distingue pas les couleurs (§8.1). #}
                <a class="exchange-card {{ selected and selected.id == ex.id ? 'is-active' }} {{ ex.hasUnread ? 'exchange-card--unread' }}"
                   id="exchange-card-{{ ex.id }}"
                   href="{{ path('app_echanges', { exchange: ex.id, status: statusFilter }) }}">
                    <div class="exchange-card__head">
                        {% if ex.hasUnread %}<span class="exchange-card__unread" title="Nouveaux messages"><span class="sr-only">Non lu — </span></span>{% endif %}
                        <span class="exchange-tag exchange-tag--{{ ex.type }}">{{ ex.type == 'decision' ? 'Décision' : 'Discussion' }}</span>
                        {% if ex.overdue %}<span class="exchange-tag exchange-tag--overdue">En retard</span>{% endif %}
                        {% if ex.status == 'decided' %}<span class="exchange-tag exchange-tag--decided">Décidé</span>{% endif %}
                    </div>
                    <strong class="exchange-card__title">{{ ex.title }}</strong>
                    {# La carte disait « Un enfant » alors qu'elle avait l'identifiant sans le nom, et
                       taisait l'auteur — c'est pourtant lui qui permet de repérer « ce que l'autre
                       m'a demandé » (maquette `:430-436`, X4). #}
                    <div class="exchange-card__meta">
                        {% if ex.authorName %}
                        <span class="avatar avatar--18" style="background: {{ ex.authorColor ?: '#857E71' }}">{{ ex.authorName|first|upper }}</span>
                        <span>{{ ex.authorName }}</span>
                        <span class="exchange-card__sep" aria-hidden="true">·</span>
                        {% endif %}
                        <span>{{ ex.messageCount }} message{{ ex.messageCount > 1 ? 's' }}</span>
                        {% if ex.deadline %}<span class="exchange-card__sep" aria-hidden="true">·</span><span>échéance {{ ex.deadline|date('d/m/Y') }}</span>{% endif %}
                        <span class="exchange-card__child">{{ ex.childName ?: 'Toute la famille' }}</span>
                    </div>
                </a>
            {% else %}
                <p class="empty-state">Aucun échange pour le moment.</p>
            {% endfor %}
        </aside>

        {# ---- Détail ---- #}
        <section class="exchanges__detail">
        {% if selected is null %}
            {# Idem : sans aucun échange, « Sélectionnez un échange » n'a personne à désigner. Avec
               des échanges, le premier est désormais ouvert d'office (comme l'écran Enfants). #}
            <div class="card"><p class="empty-state">
                {{ exchanges|length ? 'Sélectionnez un échange.' : 'Aucun échange pour le moment.' }}
            </p></div>
        {% else %}
            {% set sel = selected %}
            <section class="card">
                <div class="exchange-detail__head">
                    <div>
                        <span class="exchange-tag exchange-tag--{{ sel.type }}">{{ sel.type == 'decision' ? 'Décision' : 'Discussion' }}</span>
                        {% if sel.overdue %}<span class="exchange-tag exchange-tag--overdue">En retard</span>{% endif %}
                        <h2 class="exchange-detail__title">{{ sel.title }}</h2>
                        <p class="exchange-detail__meta">
                            {# Le détail disait « Un enfant concerné », comme la carte : l'identifiant
                               était là, le prénom manquait au contrat (X4). #}
                            {{ sel.childName ?: 'Toute la famille' }}{% if sel.authorName %} · ouvert par {{ sel.authorName }}{% endif %}{% if sel.deadline %} · échéance {{ sel.deadline|date('d/m/Y') }}{% endif %}
                        </p>
                    </div>
                    {% if canEdit and sel.status == 'open' and sel.type == 'discussion' %}
                        <button class="btn btn--ghost" type="button" data-action="exchanges#closeExchange" data-exchange-id="{{ sel.id }}">Clore</button>
                    {% endif %}
                </div>
                {% if sel.body %}<p class="exchange-detail__body">{{ sel.body }}</p>{% endif %}

                {% if sel.type == 'decision' %}
                {# État du tour de vote (X1). L'écran ne disait pas ce qu'un clic engageait : la
                   décision ne bascule que lorsque TOUS les électeurs ont voté, si bien que le même
                   bouton était tantôt un brouillon, tantôt une signature. #}
                {% set decidedOption = sel.options|filter(o => o.decided)|first %}
                <p class="exchange-status {{ sel.status == 'decided' ? 'exchange-status--decided' : (sel.myVoteMaySettle ? 'exchange-status--urgent') }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {% if sel.status == 'decided' %}
                        Décidé{{ decidedOption ? ' : ' ~ decidedOption.label }}
                    {% elseif sel.myVoteMaySettle %}
                        {{ sel.awaitingVoters is empty and sel.myVotedOptionId is null
                            ? 'Tout le monde a répondu sauf vous — votre choix peut trancher la décision.'
                            : 'Votre choix peut trancher la décision.' }}
                    {% elseif sel.awaitingVoters|length %}
                        En attente de {{ sel.awaitingVoters|join(' et ') }}{{ sel.myVotedOptionId ? ' — votre choix reste modifiable' : '' }}.
                    {% elseif sel.deadline %}
                        Réponse attendue avant le {{ sel.deadline|date('d/m/Y') }}.
                    {% endif %}
                </p>

                <div class="exchange-options-list" {{ canEdit and sel.status == 'open' ? 'role="radiogroup" aria-label="Options de la décision"' : '' }}>
                    {% for o in sel.options %}
                    {% if canEdit and sel.status == 'open' %}
                        {# Sélection RÉVERSIBLE : ce bouton ne parle pas au serveur, c'est
                           « Valider mon choix » qui engage (maquette `:454-463`). #}
                        <button type="button" role="radio" aria-checked="{{ o.myVote ? 'true' : 'false' }}"
                                class="exchange-option exchange-option--choice {{ o.myVote ? 'is-chosen' }}"
                                data-exchanges-target="option" data-option-id="{{ o.id }}"
                                data-action="exchanges#chooseOption">
                            <span class="exchange-option__dot" aria-hidden="true"></span>
                            <span class="exchange-option__info">
                                <strong>{{ o.label }}</strong>
                                {% if o.sub %}<span class="exchange-option__sub">{{ o.sub }}</span>{% endif %}
                                <span class="exchange-option__count">{{ o.voteCount }} validation{{ o.voteCount > 1 ? 's' }}{{ o.myVote ? ' · votre choix' }}</span>
                            </span>
                        </button>
                    {% else %}
                        <div class="exchange-option {{ o.decided ? 'exchange-option--decided' }} {{ o.myVote ? 'is-chosen' }}">
                            <div class="exchange-option__info">
                                <strong>{{ o.label }}</strong>
                                {% if o.sub %}<span class="exchange-option__sub">{{ o.sub }}</span>{% endif %}
                                <span class="exchange-option__count">{{ o.voteCount }} validation{{ o.voteCount > 1 ? 's' }}{{ o.myVote ? ' · votre choix' }}</span>
                            </div>
                            {% if o.decided %}<span class="exchange-decided-banner">Décision tranchée</span>{% endif %}
                        </div>
                    {% endif %}
                    {% endfor %}
                </div>

                {% if canEdit and sel.status == 'open' %}
                <div class="exchange-vote-actions">
                    <button class="btn btn--primary" type="button"
                            data-exchanges-target="submitVote" data-action="exchanges#submitVote"
                            data-exchange-id="{{ sel.id }}" data-option-id="{{ sel.myVotedOptionId }}"
                            data-may-settle="{{ sel.myVoteMaySettle ? 'true' : 'false' }}"
                            {{ sel.myVotedOptionId ? '' : 'disabled' }}>
                        {{ sel.myVotedOptionId ? 'Changer mon choix' : 'Valider mon choix' }}
                    </button>
                    {# X2 — trancher une décision que personne ne vote. Le serveur l'accepte depuis
                       toujours (`decidedOptionId`) ; sans cette action, une décision non votée
                       restait ouverte et « en retard » indéfiniment. #}
                    <button class="btn btn--ghost" type="button" data-action="exchanges#settleDecision"
                            data-exchange-id="{{ sel.id }}">Retenir cette option et clore</button>
                </div>
                {% endif %}
                {% endif %}
            </section>

            {# ---- Fil de messages ---- #}
            <section class="card">
                <div class="eyebrow">Fil</div>
                {% if sel.messages is empty %}
                    <p class="empty-state">Aucun message pour le moment.</p>
                {% else %}
                    {# Tous les messages étaient posés à gauche, avatar puis texte : deux parents qui
                       s'écrivent lisaient un journal, pas un dialogue. La maquette (`:467-478`)
                       aligne les siens à droite, avec une bulle teintée — sur l'écran dont la
                       conversation est l'unique objet, c'était l'écart le plus visible (X3). #}
                    <ul class="exchange-thread">
                        {% for m in sel.messages %}
                        {% set mine = m.authorMembershipId and m.authorMembershipId == activeMembership.id ~ '' %}
                        <li class="exchange-message {{ mine ? 'exchange-message--mine' }}">
                            {% if not mine %}
                            <span class="avatar avatar--34" style="background: {{ m.authorColor ?: '#857E71' }}">{{ m.authorName ? m.authorName|first|upper : '?' }}</span>
                            {% endif %}
                            <div class="exchange-message__body">
                                <p class="exchange-message__text">{{ m.text }}</p>
                                <div class="exchange-message__meta">
                                    {% if not mine %}<strong>{{ m.authorName ?: 'Membre supprimé' }}</strong>{% endif %}
                                    <time datetime="{{ m.sentAt }}">{{ m.sentAt|date('d/m H:i', timezone) }}</time>
                                </div>
                            </div>
                        </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if canEdit %}
                <form data-action="submit->exchanges#postMessage" data-exchange-id="{{ sel.id }}" class="note-form">
                    <textarea name="text" rows="2" placeholder="Écrire un message…" required></textarea>
                    <button class="btn btn--primary" type="submit">Envoyer</button>
                </form>
                {% endif %}
            </section>
        {% endif %}
        </section>
    </div>
</div>
{% endif %}
{% endblock %}
