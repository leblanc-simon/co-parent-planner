{% extends 'base.html.twig' %}
{% block title %}Créer un compte · CoParentPlanner{% endblock %}
{% block body %}
<div class="auth">
    <div class="auth__card" data-controller="auth-form">
        <div class="auth__brand">🧡 CoParentPlanner</div>
        <h1 class="auth__title">Créer un compte</h1>
        <p class="auth__sub">Coordonnez la vie de vos enfants, sereinement.</p>

        <p class="form-note" data-auth-form-target="notice" role="status" hidden></p>

        <form data-auth-form-target="form" data-action="submit->auth-form#submit"
              action="/api/auth/register" novalidate>
            <div class="field">
                <label for="fullName">Nom complet <span class="form-note">(facultatif)</span></label>
                <input id="fullName" name="fullName" type="text" autocomplete="name">
            </div>
            <div class="field">
                <label for="email">Adresse e-mail</label>
                <input id="email" name="email" type="email" autocomplete="email" required>
            </div>
            <div class="field">
                <label for="password">Mot de passe</label>
                <input id="password" name="password" type="password" autocomplete="new-password" required minlength="12">
                <p class="form-note">12 caractères minimum.</p>
            </div>
            <p class="form-error" data-auth-form-target="error" role="alert"></p>
            <button class="btn btn--primary btn--block" type="submit" data-auth-form-target="submit">Créer mon compte</button>
        </form>

        <p class="auth__alt">Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a></p>
    </div>
</div>
{% endblock %}
