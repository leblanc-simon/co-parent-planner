{# Fragment d'une note (réutilisé par la fiche enfant et le push Turbo Stream temps réel). #}
<li class="note-item">
    <span class="avatar avatar--22" style="background: {{ note.authorColor ?: '#C2643D' }}">{{ note.authorName|first|upper }}</span>
    <div class="note-item__body">
        <div class="note-item__meta">
            <strong>{{ note.authorName }}</strong>
            {# `noteDate` reste la valeur machine (Y-m-d) ; `noteDateLabel` porte le libellé FR.
               Sans cette séparation la fiche enfant affichait « 2026-07-26 » quand l'accueil
               affichait « 26/07 » pour la même note. #}
            <time datetime="{{ note.noteDate }}">{{ note.noteDateLabel ?? note.noteDate }}</time>
        </div>
        <p class="note-item__text">{{ note.text }}</p>
    </div>
</li>
