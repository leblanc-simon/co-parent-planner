{% extends 'app/shell.html.twig' %}
{% block title %}Agenda · CoParentPlanner{% endblock %}
{% set nav_active = 'agenda' %}

{% set catClass = {'sport':'sport','musique':'music','ecole':'school','sante':'health','autre':'other'} %}
{% set catLabel = {'sport':'Sport','musique':'Musique','ecole':'École','sante':'Santé','autre':'Autre'} %}

{% block main %}
<header class="main__header">
    <div>
        <div class="eyebrow">Planning</div>
        <h1>Agenda</h1>
    </div>
</header>

{% if not canView %}
    <section class="card"><p class="empty-state">Vous n'avez pas accès à l'agenda de cette famille.</p></section>
{% else %}
<div data-controller="agenda"
     data-agenda-family-id-value="{{ family.id }}"
     data-agenda-timezone-value="{{ timezone }}">
    <p class="form-error" data-agenda-target="error" role="alert" hidden></p>
    <p class="form-success" data-agenda-target="notice" role="status" aria-live="polite" hidden></p>

    {# Abonnement temps réel (Turbo Stream over Mercure). `<turbo-mercure-stream-source>` de UX Turbo,
       seul élément qui honore `private` et transmet donc le cookie d'abonnement au hub — voir le
       commentaire détaillé dans `garde.html.twig` (revue 2026-08 C2). #}
    <turbo-mercure-stream-source private data-controller="realtime" src="{{ mercureHub }}?topic={{ agendaTopic|url_encode }}"></turbo-mercure-stream-source>

    {# ───────── Navigation mois + filtres catégorie ───────── #}
    <section class="card">
        <div class="garde-cal__nav">
            <strong class="garde-cal__title">{{ monthLabel }}</strong>
            <div class="garde-cal__nav-actions">
                <a class="garde-cal__nav-btn" href="{{ path('app_agenda', { month: prevMonth }) }}" aria-label="Mois précédent">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                </a>
                <a class="garde-cal__nav-btn" href="{{ path('app_agenda', { month: nextMonth }) }}" aria-label="Mois suivant">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                </a>
            </div>
        </div>
        <div class="agenda-filters">
            <a class="agenda-chip {{ activeCategories is empty ? 'is-active' }}"
               {% if activeCategories is empty %}aria-current="page"{% endif %}
               href="{{ path('app_agenda', { month: monthValue }) }}">Toutes</a>
            {% for c in categories %}
                <a class="agenda-chip pill--{{ catClass[c.value] }} {{ c.value in activeCategories ? 'is-active' }}"
                   {% if c.value in activeCategories %}aria-current="page"{% endif %}
                   href="{{ path('app_agenda', { month: monthValue, category: c.value }) }}">{{ catLabel[c.value] }}</a>
            {% endfor %}
        </div>
        {# ───────── Overlay familles liées (US-AG-4) ───────── #}
        {% if overlayLinks is not empty %}
        <div class="agenda-overlay-toggles">
            {% for link in overlayLinks %}
            <label class="overlay-card">
                <span class="overlay-card__body">
                    <span class="overlay-card__title"><i class="agenda-linked-square"></i> {{ link.name }}</span>
                    <span class="overlay-card__sub">Événements de la famille liée</span>
                </span>
                <span class="switch">
                    <input type="checkbox" {{ link.enabled ? 'checked' }}
                           data-action="change->agenda#toggleOverlay" data-link-id="{{ link.linkId }}" data-view="agenda">
                    <span class="switch__slider"></span>
                </span>
            </label>
            {% endfor %}
        </div>
        {% endif %}
    </section>

    {# ───────── Création (CTA compact → panneau dépliable) ───────── #}
    {% if canEdit %}
    <details class="create-panel card">
        <summary class="create-panel__cta">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            Ajouter
        </summary>
        <form data-action="submit->agenda#createEvent" class="agenda-form">
            <div class="grid-2">
                <div class="field"><label for="a-title">Titre</label><input id="a-title" name="title" required maxlength="200"></div>
                <div class="field"><label for="a-cat">Catégorie</label>
                    <select id="a-cat" name="category">{% for c in categories %}<option value="{{ c.value }}">{{ catLabel[c.value] }}</option>{% endfor %}</select>
                </div>
                <div class="field"><label for="a-resp">Responsable</label>
                    {# Foyer (E2) : un beau-parent est présenté avec le parent qu'il accompagne. Sans
                       cette mention, une liste de quatre adultes ne dit pas de quel côté chacun se
                       range, et le responsable d'une activité se choisit au jugé. La relation est
                       portée par le beau-parent, d'où la lecture directe (sans requête inverse). #}
                    <select id="a-resp" name="responsibleMembershipId">{% for m in parents %}<option value="{{ m.id }}">{{ m.user.fullName ?: m.user.email }}{% if m.partnerMembership %} · conjoint·e de {{ m.partnerMembership.user.fullName ?: m.partnerMembership.user.email }}{% endif %}</option>{% endfor %}</select>
                </div>
                <div class="field"><label for="a-loc">Lieu</label><input id="a-loc" name="location" maxlength="255"></div>
            </div>
            {# Commentaire (revue 6.2) : le gabarit savait l'AFFICHER (`.agenda-event__desc`) et
               l'API l'accepte de bout en bout (`CreateEventRequest::$description`, max 2000), mais
               aucun formulaire ne permettait de le saisir — l'information n'avait aucun moyen
               d'entrer dans le système. `maxlength` aligné sur la contrainte serveur pour que la
               limite se voie avant l'envoi plutôt que sous forme de 422. #}
            <div class="field">
                <label for="a-desc">Commentaire</label>
                <textarea id="a-desc" name="description" rows="2" maxlength="2000" placeholder="Précisions utiles à l'autre parent (facultatif)"></textarea>
            </div>
            <fieldset class="agenda-target">
                <legend>Concerne</legend>
                <label><input type="checkbox" name="wholeFamily" data-action="change->agenda#toggleWholeFamily" data-agenda-target="wholeFamily"> Toute la famille</label>
                <span class="agenda-target__children" data-agenda-target="children">
                    {% for c in children %}<label><input type="checkbox" name="childIds[]" value="{{ c.id }}"> {{ c.firstName }}</label>{% endfor %}
                </span>
            </fieldset>
            <div class="grid-2">
                <div class="field agenda-allday"><label><input type="checkbox" name="allDay" data-action="change->agenda#toggleAllDay" data-agenda-target="allDay"> Journée entière</label></div>
                <div></div>
                <div class="field" data-agenda-target="startTimed"><label for="a-start">Début</label><input id="a-start" name="startsAt" type="datetime-local"></div>
                <div class="field" data-agenda-target="endTimed"><label for="a-end">Fin</label><input id="a-end" name="endsAt" type="datetime-local"></div>
                <div class="field" data-agenda-target="startAllDay" hidden><label for="a-start-day">Date</label><input id="a-start-day" name="startsAtDay" type="date"></div>
            </div>
            <div class="grid-2">
                <div class="field"><label for="a-freq">Récurrence</label>
                    <select id="a-freq" name="freq" data-action="change->agenda#toggleRecurrence" data-agenda-target="freq">
                        <option value="none">Aucune (ponctuel)</option>
                        <option value="weekly">Chaque semaine</option>
                        <option value="biweekly">Une semaine sur deux</option>
                        <option value="monthly">Chaque mois</option>
                    </select>
                </div>
                <div class="agenda-recurrence" data-agenda-target="recurrence" hidden>
                    <div class="field"><label for="a-until">Jusqu'au</label><input id="a-until" name="until" type="date"></div>
                    <div class="field"><label for="a-count">ou nombre d'occurrences</label><input id="a-count" name="count" type="number" min="1"></div>
                    <label class="agenda-check"><input type="checkbox" name="excludeHolidays"> Exclure les vacances scolaires</label>
                </div>
            </div>
            <button class="btn btn--primary" type="submit">Créer</button>
        </form>
    </details>
    {% endif %}

    {# ───────── Occurrences groupées par jour ───────── #}
    <section class="card" style="margin-top:1.25rem">
        {# Le mois était écrit deux fois sur le même écran — ici et dans la barre de navigation
           juste au-dessus, qui est celle qui le pilote. #}
        {% if days is empty %}
            <p class="empty-state">Aucun événement ce mois-ci.</p>
        {% else %}
            {% for day in days %}
            <div class="agenda-day">
                <h2 class="agenda-day__label">{{ day.label }}</h2>
                <ul class="agenda-events">
                    {% for occ in day.items %}
                    <li class="agenda-event agenda-event--{{ catClass[occ.category.value] }}">
                        <details>
                            <summary>
                                <span class="agenda-event__time">{% if occ.allDay %}Journée{% else %}{{ occ.startsAt|date('H:i', timezone) }}{% endif %}</span>
                                <span class="agenda-event__sep"></span>
                                <span class="agenda-event__body">
                                    <strong class="agenda-event__title">{{ occ.title }}</strong>
                                    <span class="agenda-event__who">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#B7AF9F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                        {% if occ.wholeFamily %}Toute la famille{% else %}{% for c in occ.children %}{{ c.firstName }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}
                                        {% if occ.responsibleMembership %} · {{ occ.responsibleMembership.user.fullName ?: occ.responsibleMembership.user.email }}{% endif %}
                                    </span>
                                </span>
                                <span class="pill pill--{{ catClass[occ.category.value] }} agenda-event__pill">{{ catLabel[occ.category.value] }}</span>
                                {% if occ.isOverride %}<span class="agenda-event__badge">modifié</span>{% endif %}
                            </summary>
                            {% if occ.location %}<p class="agenda-event__loc">📍 {{ occ.location }}</p>{% endif %}
                            {% if occ.description %}<p class="agenda-event__desc">{{ occ.description }}</p>{% endif %}
                            {% if canEdit %}
                            {# Chaque libellé était posé AVANT son champ, sans `for` et sans
                               l'envelopper : rien ne les associait, ni pour un lecteur d'écran, ni
                               pour le clic (WCAG 1.3.1/4.1.2). Le panneau se répète par occurrence,
                               d'où une clé par occurrence — l'identifiant d'événement seul se
                               répéterait sur toutes les occurrences d'une série. #}
                            {% set oid = occ.eventId ~ '-' ~ occ.recurrenceDate|date('Ymd') %}
                            <form class="agenda-edit" data-action="submit->agenda#saveEvent"
                                  data-event-id="{{ occ.eventId }}" data-recurring="{{ occ.isRecurring ? '1' : '0' }}"
                                  data-recurrence-date="{{ occ.recurrenceDate|date('Y-m-d') }}">
                                <div class="grid-2">
                                    <div class="field"><label for="e-title-{{ oid }}">Titre</label><input id="e-title-{{ oid }}" name="title" value="{{ occ.title }}" maxlength="200"></div>
                                    <div class="field"><label for="e-cat-{{ oid }}">Catégorie</label><select id="e-cat-{{ oid }}" name="category">{% for c in categories %}<option value="{{ c.value }}" {{ c.value == occ.category.value ? 'selected' }}>{{ catLabel[c.value] }}</option>{% endfor %}</select></div>
                                    {% if not occ.allDay %}
                                    <div class="field"><label for="e-start-{{ oid }}">Début</label><input id="e-start-{{ oid }}" name="startsAt" type="datetime-local" value="{{ occ.startsAt|date('Y-m-d\\TH:i', timezone) }}"></div>
                                    <div class="field"><label for="e-end-{{ oid }}">Fin</label><input id="e-end-{{ oid }}" name="endsAt" type="datetime-local" value="{{ occ.endsAt ? occ.endsAt|date('Y-m-d\\TH:i', timezone) }}"></div>
                                    {% endif %}
                                    <div class="field"><label for="e-loc-{{ oid }}">Lieu</label><input id="e-loc-{{ oid }}" name="location" value="{{ occ.location }}" maxlength="255"></div>
                                </div>
                                {# Commentaire éditable (revue 6.2). Le contrôleur Stimulus n'ajoute
                                   `description` au PATCH que si le champ est présent, précisément
                                   pour ne pas effacer la valeur depuis un formulaire qui l'ignore. #}
                                <div class="field">
                                    <label for="e-desc-{{ oid }}">Commentaire</label>
                                    <textarea id="e-desc-{{ oid }}" name="description" rows="2" maxlength="2000">{{ occ.description }}</textarea>
                                </div>
                                {% if occ.isRecurring %}
                                <div class="field"><label for="e-scope-{{ oid }}">Portée</label>
                                    <select id="e-scope-{{ oid }}" name="scope"><option value="occurrence">Cette occurrence</option><option value="series">Toute la série (à partir d'ici)</option></select>
                                </div>
                                {% endif %}
                                <div class="agenda-edit__actions">
                                    <button class="btn btn--ghost" type="submit">Enregistrer</button>
                                    <button class="btn btn--ghost btn--danger" type="button" data-action="agenda#deleteEvent">Supprimer</button>
                                </div>
                            </form>
                            {% endif %}
                        </details>
                    </li>
                    {% endfor %}
                    {# ── Événements de la famille liée (overlay, lecture seule §3.3) ── #}
                    {% for ov in day.overlay %}
                    <li class="agenda-event agenda-event--linked">
                        <span class="agenda-linked-badge">Famille liée</span>
                        <span class="agenda-event__time">{% if ov.allDay %}Journée{% else %}{{ ov.startsAt|date('H:i', timezone) }}{% endif %}</span>
                        <strong class="agenda-event__title">{{ ov.title }}</strong>
                        <span class="pill" style="color: var(--linked); background: #EFE6F4">{{ catLabel[ov.category]|default(catLabel['autre']) }}</span>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endfor %}
        {% endif %}
        {% if overlayActive and overlayCount == 0 %}
            <p class="empty-state">Aucune activité de la famille liée sur cette période.</p>
        {% endif %}
    </section>
</div>
{% endif %}
{% endblock %}
