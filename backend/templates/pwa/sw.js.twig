/* Service worker CoParentPlanner (Lot 8 §3.7). Généré par Symfony (chemins d'assets digérés injectés).
 * Offline WEB = dégradé : lecture seule des écrans consultés + shell ; AUCUNE file d'écriture
 * (décision verrouillée cdc §4.3). Cache cloisonné par famille (jamais de mélange de scopes, §2.2). */
const VERSION = '{{ version }}';
const STATIC_CACHE = 'cpp-static-' + VERSION;
const PAGES_CACHE = 'cpp-pages-' + VERSION;
const OFFLINE_URL = '{{ path('app_offline')|e('js') }}';
const PRECACHE = {{ precache|json_encode|raw }};

/* Périmètre du cache de pages : famille active ET utilisateur, fournis par le client (le SW ne peut
 * pas lire les cookies). Le cloisonnement par famille seule laissait, après un changement de compte
 * sur le même appareil, les écrans du compte précédent accessibles hors ligne — notes comprises
 * (revue 2026-08 C4). Persisté dans un cache dédié : une variable de module ne survit pas à la mise
 * en veille du worker, et le scope doit être connu dès le premier `fetch` du réveil. */
const SCOPE_CACHE = 'cpp-scope';
const SCOPE_KEY = '/__cpp_scope';
let scopePromise = null;

async function readScope() {
    if (null === scopePromise) {
        scopePromise = (async () => {
            try {
                const cached = await (await caches.open(SCOPE_CACHE)).match(SCOPE_KEY);
                return cached ? await cached.json() : { user: '', family: '' };
            } catch (e) {
                return { user: '', family: '' };
            }
        })();
    }

    return scopePromise;
}

async function writeScope(scope) {
    scopePromise = Promise.resolve(scope);
    try {
        await (await caches.open(SCOPE_CACHE)).put(SCOPE_KEY, new Response(JSON.stringify(scope)));
    } catch (e) {
        /* stockage indisponible : le scope reste en mémoire pour la durée de vie du worker */
    }
}

/** Vide le cache des écrans : déconnexion, changement de compte. Les assets versionnés restent. */
async function purgePages() {
    try {
        await caches.delete(PAGES_CACHE);
    } catch (e) {
        /* rien à purger */
    }
}

self.addEventListener('install', (event) => {
    event.waitUntil(caches.open(STATIC_CACHE).then((c) => c.addAll(PRECACHE)).catch(() => {}));
});

self.addEventListener('activate', (event) => {
    event.waitUntil((async () => {
        const keys = await caches.keys();
        await Promise.all(
            keys.filter((k) => k.startsWith('cpp-') && k !== SCOPE_CACHE && !k.endsWith(VERSION)).map((k) => caches.delete(k)),
        );
        await self.clients.claim();
    })());
});

self.addEventListener('message', (event) => {
    const data = event.data || {};
    if (data.type === 'scope') {
        event.waitUntil((async () => {
            const previous = await readScope();
            const next = { user: data.user || '', family: data.family || '' };
            // Changement de compte (y compris passage à « déconnecté ») : les écrans mis en cache
            // appartiennent à l'utilisateur précédent — ils ne doivent pas lui survivre.
            if (previous.user !== next.user) { await purgePages(); }
            await writeScope(next);
        })());
    }
    if (data.type === 'skip-waiting') { self.skipWaiting(); }
});

self.addEventListener('fetch', (event) => {
    const req = event.request;
    const url = new URL(req.url);
    if (url.origin !== self.location.origin) { return; }

    // Déconnexion : purge immédiate des écrans mis en cache (revue C4). Fait ici plutôt que côté
    // page, car le POST /logout redirige et la page appelante disparaît avant de pouvoir prévenir.
    if (req.method === 'POST' && url.pathname === '/logout') {
        event.respondWith(fetch(req).finally(() => purgePages()));
        return;
    }

    // Mutations : jamais mises en file hors-ligne ; message clair (US-PWA-3), état inchangé.
    if (req.method !== 'GET') {
        event.respondWith(
            fetch(req).catch(() => {
                broadcast({ type: 'offline-mutation' });
                return new Response(JSON.stringify({ offline: true }), {
                    status: 503, headers: { 'Content-Type': 'application/json' },
                });
            }),
        );
        return;
    }

    // Assets versionnés : cache-first (immutables par hash).
    if (url.pathname.startsWith('/assets/')) {
        event.respondWith(cacheFirst(req));
        return;
    }

    // Navigations d'écrans : network-first, repli sur le cache (cloisonné famille), sinon page offline.
    if (req.mode === 'navigate') {
        event.respondWith(navigationStrategy(req));
        return;
    }

    // Autres GET même origine : réseau, repli cache.
    event.respondWith(fetch(req).catch(() => caches.match(req).then((r) => r || offlineFallback())));
});

async function cacheFirst(req) {
    const cached = await caches.match(req);
    if (cached) { return cached; }
    try {
        const resp = await fetch(req);
        if (resp.ok) { (await caches.open(STATIC_CACHE)).put(req, resp.clone()); }
        return resp;
    } catch (e) {
        return offlineFallback();
    }
}

async function navigationStrategy(req) {
    const key = await scopedKey(req.url);
    try {
        const resp = await fetch(req);
        // `resp.redirected` : `fetch` suit les 302, donc une session expirée renvoyait la page de
        // login… mémorisée sous l'URL de l'écran demandé, qui affichait ensuite un login hors ligne
        // (revue C4). Une réponse redirigée n'est jamais représentative de l'URL demandée.
        if (resp.ok && !resp.redirected) { (await caches.open(PAGES_CACHE)).put(key, resp.clone()); }
        return resp;
    } catch (e) {
        const cached = await caches.match(key);
        return cached || offlineFallback();
    }
}

async function offlineFallback() {
    return (await caches.match(OFFLINE_URL)) || new Response('Hors-ligne', { status: 503 });
}

/* Clé de cache cloisonnée par utilisateur ET famille : ni deux familles ni deux comptes ne partagent
 * jamais le même écran caché. */
async function scopedKey(rawUrl) {
    const scope = await readScope();
    const u = new URL(rawUrl);
    u.searchParams.set('__usr', scope.user);
    u.searchParams.set('__fam', scope.family);
    return u.toString();
}

function broadcast(message) {
    self.clients.matchAll().then((clients) => clients.forEach((c) => c.postMessage(message)));
}
