{% extends 'base.html.twig' %}
{% block title %}Se connecter et rejoindre · CoParentPlanner{% endblock %}
{% block body %}
{# Landing d'invitation quand un compte existe DÉJÀ pour l'adresse invitée (flux simplifié §3.3).
   Connexion ET acceptation en un POST : le mot de passe est exigé (frontière de sécurité — un lien
   transféré ne détourne pas un compte tiers). Libellés FR (UI web 100 % hardcodée). #}
<div class="auth">
    <div class="auth__card">
        <div class="auth__brand"><img class="auth__logo" src="{{ asset('icons/logo.png') }}" width="28" height="28" alt=""> CoParentPlanner</div>

        <h1 class="auth__title">Rejoindre {{ familyName }}</h1>
        <p class="auth__sub">Un compte existe déjà pour cette adresse. Connectez-vous pour rejoindre « {{ familyName }} ».</p>

        <form data-controller="auth-form" data-action="submit->auth-form#submit"
              data-auth-form-redirect-value="{{ path('app_invitation_accepted') }}"
              action="/api/auth/login-and-accept-invitation" novalidate>
            <input type="hidden" name="token" value="{{ token }}">
            <div class="field">
                <label for="email">Adresse e-mail</label>
                <input id="email" type="email" value="{{ invitationEmail }}" autocomplete="email" readonly>
            </div>
            <div class="field">
                <label for="password">Mot de passe</label>
                <input id="password" name="password" type="password" autocomplete="current-password" required>
            </div>
            <p class="form-error" data-auth-form-target="error" role="alert"></p>
            <button class="btn btn--primary btn--block" type="submit" data-auth-form-target="submit">Se connecter et rejoindre {{ familyName }}</button>
        </form>

        <p class="auth__alt"><a href="{{ path('app_forgot') }}">Mot de passe oublié ?</a></p>
    </div>
</div>
{% endblock %}
