{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié · CoParentPlanner{% endblock %}
{% block body %}
<div class="auth">
    <div class="auth__card" data-controller="auth-form">
        <div class="auth__brand">🧡 CoParentPlanner</div>
        <h1 class="auth__title">Mot de passe oublié</h1>
        <p class="auth__sub">Saisissez votre e-mail pour recevoir un lien de réinitialisation.</p>

        <p class="form-note" data-auth-form-target="notice" role="status" hidden></p>

        <form data-auth-form-target="form" data-action="submit->auth-form#submit"
              action="/api/auth/password/forgot" novalidate>
            <div class="field">
                <label for="email">Adresse e-mail</label>
                <input id="email" name="email" type="email" autocomplete="email" required>
            </div>
            <p class="form-error" data-auth-form-target="error" role="alert"></p>
            <button class="btn btn--primary btn--block" type="submit" data-auth-form-target="submit">Envoyer le lien</button>
        </form>

        <p class="auth__alt"><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
    </div>
</div>
{% endblock %}
