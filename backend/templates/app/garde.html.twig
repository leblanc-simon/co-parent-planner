{% extends 'app/shell.html.twig' %}
{% block title %}Garde · CoParentPlanner{% endblock %}
{% set nav_active = 'garde' %}

{% set pAName = 'Parent A' %}
{% set pBName = 'Parent B' %}
{% for m in parents %}
    {% if m.id == parentAId %}{% set pAName = m.user.fullName ?: m.user.email %}{% endif %}
    {% if m.id == parentBId %}{% set pBName = m.user.fullName ?: m.user.email %}{% endif %}
{% endfor %}
{% set rhythmLabel = {'alternating':'Une semaine sur deux','pattern_2_2_3':'Rythme 2-2-3','midweek_weekends':'Milieu de semaine + week-ends','custom':'Rythme personnalisé (14 jours)'} %}

{% block main %}
<header class="main__header">
    <div>
        <div class="eyebrow">Planning</div>
        <h1>Planning de garde</h1>
        {% if pattern %}<p class="main__subtitle">{{ rhythmLabel[pattern.kind.value] ?? '' }}{% if pattern.handoverTime %} · échange à {{ pattern.handoverTime }}{% endif %}</p>{% endif %}
    </div>
</header>

{% if intact %}
    <section class="card"><p class="empty-state">Toute la famille est réunie — pas de planning de garde.</p></section>
{% elseif not canView %}
    <section class="card"><p class="empty-state">Vous n'avez pas accès au planning de garde de cette famille.</p></section>
{% else %}
<div data-controller="garde"
     data-garde-family-id-value="{{ family.id }}"
     data-garde-parent-a-value="{{ parentAId }}"
     data-garde-parent-b-value="{{ parentBId }}">
    <p class="form-error" data-garde-target="error" role="alert" hidden></p>
    <p class="form-success" data-garde-target="notice" role="status" aria-live="polite" hidden></p>

    {# Abonnement temps réel : un changement de garde rafraîchit la page (Turbo Stream). #}
    <turbo-stream-source src="{{ mercureHub }}?topic={{ custodyTopic|url_encode }}"></turbo-stream-source>

    {# ───────── Overlay familles liées : pastilles d'activité (US-CUST-5) ───────── #}
    {% if overlayLinks is defined and overlayLinks is not empty %}
    <section class="card" style="margin-bottom:1.25rem">
        <div class="agenda-overlay-toggles" style="border-top:none;padding-top:0;margin-top:0">
            {% for link in overlayLinks %}
            <label class="agenda-overlay-toggle">
                <input type="checkbox" {{ link.enabled ? 'checked' }}
                       data-action="change->garde#toggleOverlay" data-link-id="{{ link.linkId }}" data-view="custody">
                <span><i class="agenda-linked-dot"></i> Overlay famille liée · {{ link.name }}</span>
            </label>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if pattern is null %}
        <section class="card">
            <p class="empty-state">Aucun rythme de garde configuré.</p>
            {% if canEdit %}<p>Configurez un rythme dans <a href="{{ path('app_settings') }}#sec-custody">Paramètres › Rythme de garde</a> pour générer le planning.</p>{% endif %}
        </section>
    {% else %}
    <div class="garde-layout">
    {# ───────── Calendrier mensuel ───────── #}
    <section class="card garde-cal-card">
        <div class="garde-cal__nav">
            <strong class="garde-cal__title">{{ monthLabel }}</strong>
            <div class="garde-cal__nav-actions">
                <div class="garde-legend">
                    <span><i class="garde-dot garde-dot--a"></i> {{ pAName }}</span>
                    <span><i class="garde-dot garde-dot--b"></i> {{ pBName }}</span>
                </div>
                <a class="garde-cal__nav-btn" href="{{ path('app_garde', { month: prevMonth }) }}" aria-label="Mois précédent">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                </a>
                <a class="garde-cal__nav-btn" href="{{ path('app_garde', { month: nextMonth }) }}" aria-label="Mois suivant">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                </a>
            </div>
        </div>
        <div class="garde-cal">
            {% for d in ['Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi','Dimanche'] %}<div class="garde-cal__dow">{{ d }}</div>{% endfor %}
            {% for week in weeks %}
                {% for cell in week %}
                    <div class="garde-day garde-day--{{ cell.slot == 'A' ? 'a' : (cell.slot == 'B' ? 'b' : 'none') }}
                                {{ cell.source == 'exception' ? 'garde-day--exception' }}
                                {{ cell.isToday and cell.inMonth ? 'garde-day--today' }}
                                {{ not cell.inMonth ? 'garde-day--out' }}"
                         {% if canEdit and cell.inMonth and cell.slot %}
                            data-action="click->garde#swapDay keydown.enter->garde#swapDay keydown.space->garde#swapDay"
                            data-date="{{ cell.date }}" data-slot="{{ cell.slot }}"
                            data-date-label="{{ cell.date|date('d/m/Y') }}"
                            role="button" tabindex="0" title="Échanger ce jour"
                            aria-label="{{ cell.date|date('d/m/Y') }} — chez {{ cell.slot == 'A' ? pAName : pBName }}{{ cell.source == 'exception' ? ' (exception)' }}{{ cell.source == 'holiday' ? ' (vacances scolaires)' }}. Échanger ce jour."
                         {% elseif cell.inMonth and cell.slot %}
                            aria-label="{{ cell.date|date('d/m/Y') }} — chez {{ cell.slot == 'A' ? pAName : pBName }}{{ cell.source == 'exception' ? ' (exception)' }}{{ cell.source == 'holiday' ? ' (vacances scolaires)' }}"
                         {% endif %}>
                        <span class="garde-day__num">{{ cell.day }}</span>
                        {% if cell.source == 'holiday' %}<span class="garde-day__tag">vac.</span>{% endif %}
                        {% if overlayBadges is defined and overlayBadges[cell.date] is defined %}<span class="garde-day__overlay" title="Famille liée"></span>{% endif %}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    </section>

    <aside class="garde-aside">
        {# ───────── Statistiques ───────── #}
        <section class="card">
            <div class="eyebrow">Statistiques du mois</div>
            <div class="garde-stats">
                <div class="garde-stat garde-stat--a">
                    <strong>{{ stats.parentACount }}</strong>
                    <span>{{ pAName }} · {{ stats.pctA }} %</span>
                </div>
                <div class="garde-stat garde-stat--b">
                    <strong>{{ stats.parentBCount }}</strong>
                    <span>{{ pBName }} · {{ stats.pctB }} %</span>
                </div>
            </div>
        </section>

        {# ───────── Périodes spéciales du mois affiché ─────────
           Ne liste que les périodes qui CHEVAUCHENT le mois affiché : le panneau jouxte
           « Statistiques du mois », et lister tout l'historique de la famille y faisait apparaître
           des vacances déjà passées (l'import ramène l'année scolaire entière).
           Les dates portent leur année : « 18/10→02/11 » était ambigu à un an près.
           La barre A/B décorative a été retirée : deux `flex: 1` donnaient TOUJOURS un 50/50, ce qui
           laissait croire à un partage défini là où aucune règle n'existait, et contredisait une
           exception attribuée en entier à un seul parent. #}
        {% if exceptions|length or holidays|length %}
        <section class="card">
            <div class="eyebrow">Périodes spéciales du mois</div>
            <div class="garde-special">
                {% for e in exceptions %}
                <div class="garde-special__item">
                    <div class="garde-special__head">
                        <span class="garde-special__title">Exception{% if e.reason %} · {{ e.reason }}{% endif %}</span>
                        <span class="garde-special__dates">{{ e.startDate|date('d/m/Y') }}→{{ e.endDate|date('d/m/Y') }}</span>
                    </div>
                    <div class="garde-special__rule">
                        Chez {{ e.parentMembership ? (e.parentMembership.user.fullName ?: e.parentMembership.user.email) : '—' }}
                    </div>
                </div>
                {% endfor %}
                {% for h in holidays %}
                <div class="garde-special__item">
                    <div class="garde-special__head">
                        <span class="garde-special__title">{{ h.label }}</span>
                        <span class="garde-special__dates">{{ h.startDate|date('d/m/Y') }}→{{ h.endDate|date('d/m/Y') }}</span>
                    </div>
                    <div class="garde-special__rule">
                        {% if h.rule %}
                            {{ holidayRuleLabel[h.rule.kind.value] ?? h.rule.kind.value }}
                        {% else %}
                            <span class="garde-special__norule">Aucune règle de partage — le rythme habituel s'applique</span>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
        </section>
        {% endif %}
    </aside>
    </div>
    {% endif %}

    {# La configuration du rythme, les exceptions et les vacances vivent désormais dans
       Paramètres › Rythme de garde (édition), pour garder cet écran centré sur la consultation. #}
</div>
{% endif %}
{% endblock %}
