{% extends 'app/shell.html.twig' %}
{% block title %}Paramètres · CoParentPlanner{% endblock %}
{% set nav_active = 'settings' %}

{% set editableDomains = ['custody', 'agenda', 'children_notes', 'exchanges'] %}
{% set levels = ['none', 'view', 'edit'] %}

{% set pAName = 'Parent A' %}
{% set pBName = 'Parent B' %}
{% for m in parents %}
    {% if m.id == parentAId %}{% set pAName = m.user.fullName ?: m.user.email %}{% endif %}
    {% if m.id == parentBId %}{% set pBName = m.user.fullName ?: m.user.email %}{% endif %}
{% endfor %}

{% block main %}
<div data-controller="settings" data-settings-family-id-value="{{ family.id }}">
<header class="main__header">
    <div>
        <div class="eyebrow">Paramètres</div>
        <h1>Compte &amp; Famille</h1>
    </div>
</header>

<p class="form-error" data-settings-target="error" role="alert" hidden></p>
<p class="form-success" data-settings-target="notice" role="status" aria-live="polite" hidden></p>

<div class="settings-layout">
<nav class="settings-nav">
    <a href="#sec-account">Mon compte</a>
    <a href="#sec-notifications">Notifications</a>
    <a href="#sec-family">Famille</a>
    {% if canEditCustody %}
    <a href="#sec-custody">Rythme de garde</a>
    <a href="#sec-exceptions">Exceptions</a>
    <a href="#sec-holidays">Vacances</a>
    {% endif %}
    <a href="#sec-members">Membres</a>
    {% if isAdmin %}<a href="#sec-invite">Inviter</a>{% endif %}
    <a href="#sec-links">Familles liées</a>
</nav>
<div class="settings-pane">

{# ───────────── Mon compte ───────────── #}
<section class="card" id="sec-account" style="margin-bottom:1.25rem">
    <h2 class="settings-section__title">Mon compte</h2>
    <p class="settings-section__sub">Vos informations personnelles.</p>
    <div class="settings-profile">
        <span class="avatar avatar--64" style="background: {{ activeMembership.displayColor ?: '#C2643D' }}">{{ (activeMembership.user.fullName ?: activeMembership.user.email)|first|upper }}</span>
        <div class="settings-profile__id">
            <div class="settings-profile__name">{{ activeMembership.user.fullName ?: activeMembership.user.email }}</div>
            <div class="settings-profile__mail">{{ activeMembership.user.email }}</div>
        </div>
    </div>
</section>

{# ───────────── Notifications (US-SET-1, Lot 7) ───────────── #}
<section class="card" id="sec-notifications" style="margin-bottom:1.25rem" data-controller="notif-prefs">
    <h2 class="settings-section__title">Notifications</h2>
    <p class="settings-section__sub">Choisissez les e-mails que vous recevez et vos heures de silence.</p>
    <p class="form-error" data-notif-prefs-target="error" role="alert" hidden></p>
    <p class="form-success" data-notif-prefs-target="notice" role="status" aria-live="polite" hidden></p>
    <form data-action="submit->notif-prefs#save">
        {% set notifLabels = {'custody':'Garde','agenda':'Agenda','exchanges':'Échanges','invitation':'Invitations'} %}
        <div class="notif-toggles">
            {% for cat, enabled in notifPrefs %}
            <label class="notif-toggle">
                <span class="notif-toggle__label">{{ notifLabels[cat] ?? cat }}</span>
                <span class="switch">
                    <input type="checkbox" name="notif[{{ cat }}]" {{ enabled ? 'checked' }}>
                    <span class="switch__slider"></span>
                </span>
            </label>
            {% endfor %}
        </div>
        <div class="grid-2" style="margin-top:1rem">
            <div class="field"><label for="qh-start">Silence — début</label><input id="qh-start" name="quietHoursStart" type="time" value="{{ quietHoursStart }}"></div>
            <div class="field"><label for="qh-end">Silence — fin</label><input id="qh-end" name="quietHoursEnd" type="time" value="{{ quietHoursEnd }}"></div>
        </div>
        <button class="btn btn--ink" type="submit">Enregistrer les préférences</button>
    </form>
</section>

{# ───────────── Réglages de la famille (US-SET-2a) ───────────── #}
<section class="card" id="sec-family" style="margin-bottom:1.25rem">
    <h2 class="settings-section__title">Famille</h2>
    <p class="settings-section__sub">Réglages de la famille active.</p>
    {% if not isAdmin %}<p class="empty-state">Seul·e un·e administrateur·rice peut modifier ces réglages.</p>{% endif %}
    <form data-settings-target="familyForm" data-action="submit->settings#saveFamily">
        <div class="grid-2">
            <div class="field">
                <label for="f-name">Nom</label>
                <input id="f-name" name="name" value="{{ family.name }}" {{ isAdmin ? '' : 'disabled' }} required>
            </div>
            <div class="field">
                <label for="f-type">Type</label>
                <select id="f-type" name="type" {{ isAdmin ? '' : 'disabled' }}>
                    <option value="separated" {{ family.type.value == 'separated' ? 'selected' }}>Séparée</option>
                    <option value="intact" {{ family.type.value == 'intact' ? 'selected' }}>Unie</option>
                </select>
            </div>
            <div class="field">
                <label for="f-tz">Fuseau horaire</label>
                <input id="f-tz" name="timezone" value="{{ family.timezone }}" {{ isAdmin ? '' : 'disabled' }}>
            </div>
            <div class="field">
                <label for="f-zone">Zone scolaire</label>
                <select id="f-zone" name="schoolZone" {{ isAdmin ? '' : 'disabled' }}>
                    <option value="">—</option>
                    {% for z in ['A', 'B', 'C'] %}<option value="{{ z }}" {{ family.schoolZone == z ? 'selected' }}>{{ z }}</option>{% endfor %}
                </select>
            </div>
            <div class="field">
                <label for="f-academy">Académie</label>
                <input id="f-academy" name="academy" value="{{ family.academy }}" {{ isAdmin ? '' : 'disabled' }}>
            </div>
        </div>
        {# Le « jour / heure d'échange » de cette section a été RETIRÉ (revue 6.9). Il existait en
           double avec celui du § Rythme de garde, et c'était celui-ci qui était inerte : stocké dans
           `family.settings` (jsonb, « persistés non interprétés » — décision Lot 1 §3.7), il n'était
           lu ni par le moteur de garde, ni par le mobile, ni par quoi que ce soit. Il s'affichait
           donc vide alors que le rythme était configuré, et les deux champs employaient même des
           conventions incompatibles (ici 1=Lundi…7=Dimanche, là-bas 0=Dimanche…6=Samedi), si bien
           qu'une valeur recopiée de l'un vers l'autre désignait un autre jour.
           `FamilyResource.handoverWeekday/handoverTime` reste dans l'API (contrat inchangé) : seule
           la saisie disparaît de l'UI, là où la garde a une source de vérité unique. #}
        {% if isAdmin %}<button class="btn btn--primary" type="submit">Enregistrer</button>{% endif %}
    </form>
</section>

{# ───────────── Rythme de garde + exceptions + vacances (US-CUST-1/2/9) ─────────────
   Rapatriés depuis l'écran Garde (qui reste en consultation). Édition réservée à custody:edit.
   Les mutations passent par l'API via le contrôleur Stimulus `garde`, scopées X-Family-Id. #}
{% if canEditCustody and parents|length < 2 %}
{# Une garde alternée suppose DEUX parents. Avec un seul, les deux sélecteurs « Parent A » et
   « Parent B » proposaient la même personne : « Enregistrer » répondait 422 (l'API refuse un
   titulaire identique) sans jamais dire pourquoi, et `/garde` renvoyait vers ce formulaire —
   l'utilisateur bouclait entre les deux écrans pendant tout son premier jour d'usage, c'est-à-dire
   exactement au moment où il découvre le produit. On énonce la condition manquante et on donne
   l'action qui la lève. Idem pour les exceptions et les règles de vacances, qui désignent toutes un
   parent bénéficiaire : elles n'ont pas de sens avant que le second soit là. #}
<section class="card rhythm" id="sec-custody" style="margin-bottom:1.25rem">
    <h2 class="settings-section__title">Rythme de garde</h2>
    <p class="settings-section__sub">Le planning de garde répartit les jours entre <strong>deux parents</strong>. Il ne peut donc pas être configuré tant que le second parent n'a pas rejoint la famille.</p>
    <p class="empty-state">Cette famille ne compte qu'un seul parent pour l'instant.</p>
    {# La section d'invitation n'existe que pour un admin : sans cette garde, le bouton renverrait
       vers une ancre absente de la page. #}
    {% if isAdmin %}
        <p><a class="btn btn--primary" href="#sec-invite">Inviter le second parent</a></p>
    {% else %}
        <p class="form-note">Un administrateur de la famille doit l'inviter.</p>
    {% endif %}
</section>
{% elseif canEditCustody %}
{% set currentKind = pattern ? pattern.kind.value : 'alternating' %}
{% set dowShort = {0:'dim.',1:'lun.',2:'mar.',3:'mer.',4:'jeu.',5:'ven.',6:'sam.'} %}
{% set anchorW = pattern and pattern.anchorDate ? (pattern.anchorDate|date('w')) + 0 : 1 %}
<div data-controller="garde"
     data-garde-family-id-value="{{ family.id }}"
     data-garde-parent-a-value="{{ parentAId }}"
     data-garde-parent-b-value="{{ parentBId }}"
     data-garde-pa-name-value="{{ pAName }}"
     data-garde-pb-name-value="{{ pBName }}">
    <p class="form-error" data-garde-target="error" role="alert" hidden></p>
    <p class="form-success" data-garde-target="notice" role="status" aria-live="polite" hidden></p>

    {# ───────── Configuration du rythme ───────── #}
    <section class="card rhythm" id="sec-custody" style="margin-bottom:1.25rem">
        <h2 class="settings-section__title">Rythme de garde</h2>
        <p class="settings-section__sub">Définissez le rythme de résidence des enfants. La modification régénère le planning futur sans écraser les exceptions ni les règles de vacances.</p>
        <form data-action="submit->garde#savePattern" class="garde-config">
            {# ── Choix du rythme : cartes-radio ── #}
            <fieldset class="rhythm-cards">
                <legend class="sr-only">Type de rythme</legend>
                {% set kinds = [
                    {v:'alternating',      t:'Une semaine sur deux',           d:'7 jours chez chaque parent en alternance.'},
                    {v:'pattern_2_2_3',    t:'Rythme 2-2-3',                    d:'2 jours / 2 jours / 3 jours en rotation.'},
                    {v:'midweek_weekends', t:'Milieu de semaine + week-ends',   d:'Jours fixes en semaine, week-ends alternés.'},
                    {v:'custom',           t:'Personnalisé',                    d:'Compose ton propre rythme nuit par nuit.'}
                ] %}
                {% for k in kinds %}
                <label class="rhythm-card">
                    <input type="radio" name="kind" value="{{ k.v }}" {{ currentKind == k.v ? 'checked' }}
                           data-garde-target="kind" data-action="change->garde#selectKind">
                    <span class="rhythm-card__radio" aria-hidden="true"></span>
                    <span class="rhythm-card__body">
                        <span class="rhythm-card__title">{{ k.t }}</span>
                        <span class="rhythm-card__desc">{{ k.d }}</span>
                    </span>
                </label>
                {% endfor %}
            </fieldset>

            {# ── Panneau : rythme personnalisé, 14 nuits cliquables ── #}
            <div class="rhythm-panel" data-garde-target="customPanel"{% if currentKind != 'custom' %} hidden{% endif %}>
                <div class="rhythm-panel__head">
                    <div>
                        <strong class="rhythm-panel__title">Rythme personnalisé sur 2 semaines</strong>
                        <p class="rhythm-panel__hint">Clique sur une nuit pour changer de parent. La transmission se fait le soir.</p>
                    </div>
                    <div class="garde-legend rhythm-legend">
                        <span><i class="garde-dot garde-dot--a"></i> {{ pAName }}</span>
                        <span><i class="garde-dot garde-dot--b"></i> {{ pBName }}</span>
                    </div>
                </div>
                {% for wk in [0, 1] %}
                <div class="week-block">
                    <div class="week-block__label">Semaine {{ wk == 0 ? 'A' : 'B' }}</div>
                    <div class="nights">
                        {% for j in 0..6 %}
                            {% set i = wk * 7 + j %}
                            {% set v = pattern and pattern.customPattern ? (pattern.customPattern[i] ?? 'A') : (i % 2 == 0 ? 'A' : 'B') %}
                            {% set w = (anchorW + i) % 7 %}
                            <button type="button" class="night night--{{ v == 'B' ? 'b' : 'a' }}"
                                    data-garde-target="night" data-index="{{ i }}"
                                    data-action="garde#toggleNight">
                                <input type="hidden" name="custom[]" value="{{ v }}">
                                <span class="night__dow">{{ dowShort[w]|upper }}</span>
                                <span class="night__name">{{ v == 'B' ? pBName : pAName }}</span>
                            </button>
                        {% endfor %}
                    </div>
                </div>
                {% endfor %}
            </div>

            {# ── Panneau : milieu de semaine + week-ends ── #}
            {% set mw = pattern and pattern.settings ? pattern.settings : {} %}
            {% set mwWeekend = mw.weekend_days is defined ? mw.weekend_days : [6, 0] %}
            {% set mwParents = mw.weekday_parents is defined ? mw.weekday_parents : {'1':'A','2':'A','3':'B','4':'B','5':'B'} %}
            {% set mwStart = mw.weekend_start_parent is defined ? mw.weekend_start_parent : 'A' %}
            <div class="rhythm-panel" data-garde-target="midweekPanel"{% if currentKind != 'midweek_weekends' %} hidden{% endif %}>
                <div class="rhythm-panel__head">
                    <div>
                        <strong class="rhythm-panel__title">Milieu de semaine + week-ends</strong>
                        <p class="rhythm-panel__hint">Chaque jour de semaine reste chez le même parent. Clique un jour pour basculer parent A → parent B → week-end alterné.</p>
                    </div>
                    <div class="garde-legend rhythm-legend">
                        <span><i class="garde-dot garde-dot--a"></i> {{ pAName }}</span>
                        <span><i class="garde-dot garde-dot--b"></i> {{ pBName }}</span>
                        <span><i class="garde-dot garde-dot--we"></i> Week-end</span>
                    </div>
                </div>
                <div class="nights nights--mw">
                    {% for w in [1, 2, 3, 4, 5, 6, 0] %}
                        {% set isWeekend = w in mwWeekend %}
                        {% set st = isWeekend ? 'WE' : (mwParents[w~''] ?? 'A') %}
                        <button type="button" class="night night--{{ st == 'WE' ? 'we' : (st == 'B' ? 'b' : 'a') }}"
                                data-garde-target="mwDay" data-weekday="{{ w }}" data-state="{{ st }}"
                                data-action="garde#cycleDay">
                            <span class="night__dow">{{ dowShort[w]|upper }}</span>
                            <span class="night__name">{{ st == 'WE' ? 'Week-end' : (st == 'B' ? pBName : pAName) }}</span>
                        </button>
                    {% endfor %}
                </div>
                <div class="mw-start">
                    <span class="mw-start__label">Le week-end commence chez</span>
                    <div class="segmented" role="radiogroup" aria-label="Parent qui débute le week-end">
                        <label class="segmented__opt">
                            <input type="radio" name="mw_weekend_start" value="A" {{ mwStart != 'B' ? 'checked' }}>
                            <span>{{ pAName }}</span>
                        </label>
                        <label class="segmented__opt">
                            <input type="radio" name="mw_weekend_start" value="B" {{ mwStart == 'B' ? 'checked' }}>
                            <span>{{ pBName }}</span>
                        </label>
                    </div>
                </div>
            </div>

            {# ── Réglages de l'échange (ancre + jour/heure de transmission + mapping parents) ── #}
            <details class="rhythm-details"{% if not pattern %} open{% endif %}>
                <summary>Réglages de l'échange</summary>
                <div class="grid-2">
                    <div class="field">
                        <label for="g-anchor">Date d'ancrage</label>
                        <input id="g-anchor" name="anchorDate" type="date" value="{{ pattern ? pattern.anchorDate|date('Y-m-d') }}" data-action="change->garde#relabelNights" required>
                    </div>
                    <div class="field">
                        <label for="g-weekday">Jour d'échange</label>
                        <select id="g-weekday" name="handoverWeekday">
                            {% set dows = {0:'Dimanche',1:'Lundi',2:'Mardi',3:'Mercredi',4:'Jeudi',5:'Vendredi',6:'Samedi'} %}
                            {% for v, label in dows %}<option value="{{ v }}" {{ pattern and pattern.handoverWeekday == v ? 'selected' }}>{{ label }}</option>{% endfor %}
                        </select>
                    </div>
                    <div class="field">
                        <label for="g-time">Heure d'échange</label>
                        <input id="g-time" name="handoverTime" type="time" value="{{ pattern ? pattern.handoverTime : '19:00' }}">
                    </div>
                    <div class="field"></div>
                    <div class="field">
                        <label for="g-pa">Parent A</label>
                        <select id="g-pa" name="parentAMembershipId">
                            {% for m in parents %}<option value="{{ m.id }}" {{ parentAId and m.id == parentAId ? 'selected' }}>{{ m.user.fullName ?: m.user.email }}</option>{% endfor %}
                        </select>
                    </div>
                    <div class="field">
                        <label for="g-pb">Parent B</label>
                        <select id="g-pb" name="parentBMembershipId">
                            {% for m in parents %}<option value="{{ m.id }}" {{ parentBId and m.id == parentBId ? 'selected' }}>{{ m.user.fullName ?: m.user.email }}</option>{% endfor %}
                        </select>
                    </div>
                </div>
            </details>

            <button class="btn btn--primary" type="submit">Enregistrer le rythme</button>
        </form>
    </section>

    {# ───────── Exceptions ───────── #}
    <section class="card" id="sec-exceptions" style="margin-bottom:1.25rem">
        <h2 class="settings-section__title">Exceptions</h2>
        <p class="settings-section__sub">Attribuez ponctuellement une période à un parent (prioritaire sur le rythme et les vacances).</p>
        <form data-action="submit->garde#addException" class="garde-exc-form">
            <input name="startDate" type="date" required aria-label="Date de début">
            <input name="endDate" type="date" required aria-label="Date de fin">
            <select name="parentMembershipId" aria-label="Parent">{% for m in parents %}<option value="{{ m.id }}">{{ m.user.fullName ?: m.user.email }}</option>{% endfor %}</select>
            <input name="reason" placeholder="Motif (optionnel)" maxlength="200" aria-label="Motif (optionnel)">
            <button class="btn btn--ghost" type="submit">Ajouter</button>
        </form>
        {% if custodyExceptions|length %}
        <ul class="garde-list">
            {% for e in custodyExceptions %}
            <li>
                <span>{{ e.startDate|date('d/m/Y') }} → {{ e.endDate|date('d/m/Y') }} · chez {{ e.parentMembership ? (e.parentMembership.user.fullName ?: e.parentMembership.user.email) : '—' }}{% if e.reason %} · {{ e.reason }}{% endif %}</span>
                <button class="btn btn--ghost btn--danger" type="button" data-action="garde#deleteException" data-exception-id="{{ e.id }}"
                        data-exception-label="du {{ e.startDate|date('d/m/Y') }} au {{ e.endDate|date('d/m/Y') }}">Supprimer</button>
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </section>

    {# ───────── Vacances ───────── #}
    <section class="card" id="sec-holidays" style="margin-bottom:1.25rem">
        <h2 class="settings-section__title">Vacances scolaires</h2>
        <p class="settings-section__sub">Importez le calendrier officiel ou saisissez une période, puis appliquez-lui une règle de partage.</p>
        <div class="garde-holidays-actions">
            <button class="btn btn--ghost" type="button" data-action="garde#importHolidays">Importer les vacances officielles</button>
        </div>
        <form data-action="submit->garde#addHoliday" class="garde-exc-form">
            <input name="label" placeholder="Libellé" required maxlength="160" aria-label="Libellé de la période">
            <input name="startDate" type="date" required aria-label="Date de début">
            <input name="endDate" type="date" required aria-label="Date de fin">
            <button class="btn btn--ghost" type="submit">Ajouter une période</button>
        </form>
        {% if holidays|length %}
        <ul class="garde-list">
            {% for h in holidays %}
            <li>
                <span>{{ h.label }} · {{ h.startDate|date('d/m/Y') }}→{{ h.endDate|date('d/m/Y') }}{% if h.rule %} · {{ holidayRuleLabel[h.rule.kind.value] ?? h.rule.kind.value }}, à partir de {{ h.rule.params.startParent ?? h.rule.params.parent ?? h.rule.params.firstHalf ?? h.rule.params.evenParent == 'B' ? pBName : pAName }}{% endif %}</span>
                <form data-action="submit->garde#saveRule" data-holiday-id="{{ h.id }}" class="garde-rule-form">
                    <select name="kind" aria-label="Règle de partage">
                        {% for k in ['alternating_weeks','split_50_50','fixed_parent','eve_alternating'] %}
                            <option value="{{ k }}" {{ h.rule and h.rule.kind.value == k ? 'selected' }}>{{ holidayRuleLabel[k] ?? k }}</option>
                        {% endfor %}
                    </select>
                    {% set ruleParent = h.rule ? (h.rule.params.startParent ?? h.rule.params.parent ?? h.rule.params.firstHalf ?? h.rule.params.evenParent ?? 'A') : 'A' %}
                    <select name="parent" aria-label="Parent chez qui la règle commence">
                        <option value="A" {{ ruleParent == 'A' ? 'selected' }}>{{ pAName }}</option>
                        <option value="B" {{ ruleParent == 'B' ? 'selected' }}>{{ pBName }}</option>
                    </select>
                    <button class="btn btn--ghost" type="submit">Appliquer</button>
                </form>
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </section>
</div>
{% endif %}

{# ───────────── Membres (US-MBR-1/2/3/5) ───────────── #}
<section class="card" id="sec-members" style="margin-bottom:1.25rem">
    <h2 class="settings-section__title">Membres</h2>
    <p class="settings-section__sub">{{ members|length }} personne(s) dans la famille.</p>
    <div class="members">
        {% for m in members %}
        <form class="member-row" data-action="submit->settings#saveMember" data-membership-id="{{ m.id }}">
            <div class="member-row__head">
                <span class="avatar avatar--44" style="background: {{ m.displayColor ?: '#C2643D' }}">{{ (m.user.fullName ?: m.user.email)|first|upper }}</span>
                <div>
                    <strong>{{ m.user.fullName ?: m.user.email }}</strong>
                    <small>{{ m.user.email }}{{ m.user.id == activeMembership.user.id ? ' · vous' }}</small>
                </div>
                <span class="member-row__badge member-row__badge--{{ m.role.value }}">{{ roleLabel[m.role.value] ?? m.role.value }}{{ m.isAdmin ? ' · admin' }}</span>
            </div>

            <details class="member-row__edit">
            <summary>Modifier les droits</summary>
            <div class="member-row__grid">
                <label>Rôle
                    <select name="role" {{ isAdmin ? '' : 'disabled' }}>
                        {% for r in ['parent','step_parent','child'] %}<option value="{{ r }}" {{ m.role.value == r ? 'selected' }}>{{ roleLabel[r] ?? r }}</option>{% endfor %}
                    </select>
                </label>
                <label class="member-row__admin">
                    <input type="checkbox" name="isAdmin" {{ m.isAdmin ? 'checked' }} {{ isAdmin ? '' : 'disabled' }}> Admin
                </label>
                <label>Couleur
                    <input type="color" name="displayColor" value="{{ m.displayColor ?: '#C2643D' }}"
                           {{ (isAdmin or m.user.id == activeMembership.user.id) ? '' : 'disabled' }}>
                </label>
            </div>

            {% set memberRights = m.effectiveRights %}
            <div class="member-row__rights">
                {% for domain in editableDomains %}
                    <label>{{ rightDomainLabel[domain] ?? domain }}
                        <select name="rights[{{ domain }}]" {{ isAdmin ? '' : 'disabled' }}>
                            {% for lvl in levels %}<option value="{{ lvl }}" {{ memberRights[domain] == lvl ? 'selected' }}>{{ rightLevelLabel[lvl] ?? lvl }}</option>{% endfor %}
                        </select>
                    </label>
                {% endfor %}
            </div>

            <div class="member-row__actions">
                {% if isAdmin or m.user.id == activeMembership.user.id %}<button class="btn btn--ghost" type="submit">Enregistrer</button>{% endif %}
                {% if isAdmin and m.user.id != activeMembership.user.id %}
                    <button class="btn btn--ghost btn--danger" type="button" data-action="settings#removeMember" data-membership-id="{{ m.id }}"
                            data-member-name="{{ m.user.fullName ?: m.user.email }}">Retirer</button>
                {% endif %}
                {% if m.user.id == activeMembership.user.id and not m.isAdmin %}
                    <button class="btn btn--ghost btn--danger" type="button" data-action="settings#removeMember" data-membership-id="{{ m.id }}">Quitter</button>
                {% endif %}
            </div>
            </details>
        </form>
        {% endfor %}
    </div>
</section>

{# ───────────── Invitations (US-INV-1/2) ───────────── #}
{% if isAdmin %}
<section class="card" id="sec-invite" style="margin-bottom:1.25rem">
    <div class="invite-panel">
    <h3 class="invite-panel__title">Inviter une personne</h3>
    <p class="invite-panel__sub">Un e-mail d'invitation sera envoyé avec les droits choisis.</p>
    <form data-action="submit->settings#invite" data-settings-target="inviteForm">
        <div class="grid-2">
            <div class="field">
                <label for="i-email">Adresse e-mail</label>
                <input id="i-email" name="email" type="email" required>
            </div>
            <div class="field">
                <label for="i-role">Rôle</label>
                <select id="i-role" name="role" data-action="change->settings#refreshSummary" data-settings-target="inviteRole">
                    <option value="step_parent">Beau-parent</option>
                    <option value="parent">Parent</option>
                    <option value="child">Enfant</option>
                </select>
            </div>
        </div>
        <div class="invite-rights" data-settings-target="inviteRights">
            {% for domain in editableDomains %}
                <label>{{ rightDomainLabel[domain] ?? domain }}
                    <select name="rights[{{ domain }}]" data-action="change->settings#refreshSummary">
                        {% for lvl in levels %}<option value="{{ lvl }}">{{ rightLevelLabel[lvl] ?? lvl }}</option>{% endfor %}
                    </select>
                </label>
            {% endfor %}
        </div>
        <p class="invite-summary" data-settings-target="summary"></p>
        <button class="btn btn--ink" type="submit">Envoyer l'invitation</button>
    </form>
    </div>

    {% if invitations|length %}
    <div class="eyebrow" style="margin-top:1.25rem">Invitations en attente</div>
    <ul class="invitations">
        {% for inv in invitations %}
        <li>
            <span>{{ inv.email }} · {{ roleLabel[inv.role.value] ?? inv.role.value }} · expire le {{ inv.expiresAt|date('d/m/Y') }}</span>
            <button class="btn btn--ghost btn--danger" type="button" data-action="settings#revokeInvitation" data-invitation-id="{{ inv.id }}" data-invitation-email="{{ inv.email }}">Révoquer</button>
        </li>
        {% endfor %}
    </ul>
    {% endif %}
</section>
{% endif %}

{# ───────────── Familles liées (US-LINK-1/2/3) ───────────── #}
<section class="card" id="sec-links">
    <h2 class="settings-section__title">Familles liées</h2>
    <p class="settings-section__sub">Partagez l'agenda et la garde avec une autre famille.</p>
    {% if links|length %}
    <ul class="links">
        {% for link in links %}
        <li>
            <span>{{ link.otherFamily(family).name }} · <em>{{ link.status.value }}</em></span>
            <span>
                {% if isAdmin and link.status.value == 'pending' and link.linkedFamily.id == family.id %}
                    <button class="btn btn--ghost" type="button" data-action="settings#activateLink" data-link-id="{{ link.id }}">Activer</button>
                {% endif %}
                {% if isAdmin %}
                    <button class="btn btn--ghost btn--danger" type="button" data-action="settings#removeLink" data-link-id="{{ link.id }}">Délier</button>
                {% endif %}
            </span>
        </li>
        {% endfor %}
    </ul>
    {% else %}
    <p class="empty-state">Aucune famille liée.</p>
    {% endif %}

    {% if isAdmin %}
    <form data-action="submit->settings#createLink" style="margin-top:1rem">
        <div class="field">
            <label for="l-id">Identifiant de la famille à lier</label>
            <input id="l-id" name="linkedFamilyId" placeholder="UUID de la famille" required>
        </div>
        <button class="btn btn--ink" type="submit">Proposer un lien</button>
    </form>
    {% endif %}
</section>
</div>{# /settings-pane #}
</div>{# /settings-layout #}
</div>
{% endblock %}
