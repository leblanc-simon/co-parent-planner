{% extends 'app/shell.html.twig' %}
{% block title %}Garde · CoParentPlanner{% endblock %}
{% set nav_active = 'garde' %}

{# Noms et marqueurs non chromatiques résolus par le contrôleur (cdc §8) : l'initiale portée par une
   case doit toujours désigner le nom de la légende. `|default` couvre les rendus dégradés (famille
   unie, droit de lecture absent) où le calendrier n'est pas construit. #}
{% set pAName = parentNames.A|default('Parent A') %}
{% set pBName = parentNames.B|default('Parent B') %}
{% set pAInitial = initials.A|default('A') %}
{% set pBInitial = initials.B|default('B') %}
{% set rhythmLabel = {'alternating':'Une semaine sur deux','pattern_2_2_3':'Rythme 2-2-3','midweek_weekends':'Milieu de semaine + week-ends','custom':'Rythme personnalisé (14 jours)'} %}
{# Classe de couleur de catégorie des pastilles d'activité — mêmes correspondances que `/agenda`. #}
{% set catClass = {'sport':'sport','musique':'music','ecole':'school','sante':'health','autre':'other'} %}
{# Nombre d'activités listées dans une case avant bascule en « + N » : la case fait 1:1, le numéro du
   jour en occupe le haut et la rangée basse porte déjà le marqueur de parent et « vac. ». #}
{% set eventsPerCell = 2 %}

{% block main %}
<header class="main__header">
    <div>
        <div class="eyebrow">Planning</div>
        <h1>Planning de garde</h1>
        {# Le sous-titre décrit le planning : il ne doit apparaître qu'avec le droit `custody`. Rendu
           dans le header, il était affiché AVANT le branchement sur le droit, divulguant rythme et
           heure d'échange à un membre que l'API refuse (revue 2026-08 C7). Le contrôleur ne
           transmet plus non plus le pattern dans ce cas — double garde. #}
        {% if pattern|default(false) %}<p class="main__subtitle">{{ rhythmLabel[pattern.kind.value] ?? '' }}{% if pattern.handoverTime %} · échange à {{ pattern.handoverTime }}{% endif %}</p>{% endif %}
    </div>
</header>

{% if intact %}
    <section class="card"><p class="empty-state">Toute la famille est réunie — pas de planning de garde.</p></section>
{% elseif not canView %}
    <section class="card"><p class="empty-state">Vous n'avez pas accès au planning de garde de cette famille.</p></section>
{% else %}
<div data-controller="garde"
     data-garde-family-id-value="{{ family.id }}"
     data-garde-parent-a-value="{{ parentAId }}"
     data-garde-parent-b-value="{{ parentBId }}"
     {# Noms des deux parents : la confirmation d'un échange les nomme (« Attribuer le 12/09 à
        Benjamin ? »). Sans ces valeurs, l'écran retombait sur « l'autre parent ». #}
     data-garde-pa-name-value="{{ pAName }}"
     data-garde-pb-name-value="{{ pBName }}">
    <p class="form-error" data-garde-target="error" role="alert" hidden></p>
    <p class="form-success" data-garde-target="notice" role="status" aria-live="polite" hidden></p>

    {# Abonnement temps réel : un changement de garde rafraîchit la page (Turbo Stream).

       L'élément est celui de **UX Turbo** (`<turbo-mercure-stream-source>`), et non le
       `<turbo-stream-source>` natif de Turbo qui était employé jusqu'ici : ce dernier ouvre son flux
       par `new EventSource(src)`, sans `withCredentials`, et ignore purement l'attribut `private`.
       Le cookie `mercureAuthorization` n'était donc jamais transmis au hub, l'abonnement restait
       anonyme et — les quatre publishers publiant en privé — **aucun écran ne recevait jamais rien**
       (revue 2026-08 C2 ; ajouter `private` à l'élément natif, comme la revue le proposait, n'y
       change rien). Le composant est déjà chargé par `assets/controllers.json` (`turbo-core` +
       autoimport). Le cookie, lui, est posé par `App\Web\MercureSubscription` — borné dans le
       temps, et seulement si le droit du domaine est accordé (C15, C16). #}
    <turbo-mercure-stream-source private data-controller="realtime" src="{{ mercureHub }}?topic={{ custodyTopic|url_encode }}"></turbo-mercure-stream-source>

    {# ───────── Overlay familles liées : pastilles d'activité (US-CUST-5) ───────── #}
    {% if overlayLinks is defined and overlayLinks is not empty %}
    <section class="card" style="margin-bottom:1.25rem">
        <div class="agenda-overlay-toggles" style="border-top:none;padding-top:0;margin-top:0">
            {% for link in overlayLinks %}
            <label class="agenda-overlay-toggle">
                <input type="checkbox" {{ link.enabled ? 'checked' }}
                       data-action="change->garde#toggleOverlay" data-link-id="{{ link.linkId }}" data-view="custody">
                <span><i class="agenda-linked-dot"></i> Overlay famille liée · {{ link.name }}</span>
            </label>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if pattern is null %}
        <section class="card">
            <p class="empty-state">Aucun rythme de garde configuré.</p>
            {# Renvoyer vers le builder de rythme n'a de sens que s'il est utilisable. Avec un seul
               parent il répond 422, et l'utilisateur bouclait entre cet écran et /settings. #}
            {% if canEdit and parents|length < 2 %}
                <p>Le planning répartit les jours entre <strong>deux parents</strong> : il pourra être configuré dès que le second parent aura rejoint la famille.</p>
                <p><a class="btn btn--primary" href="{{ path('app_settings') }}#sec-members">Voir les membres de la famille</a></p>
            {% elseif canEdit %}
                <p>Configurez un rythme dans <a href="{{ path('app_settings') }}#sec-custody">Paramètres › Rythme de garde</a> pour générer le planning.</p>
            {% endif %}
        </section>
    {% else %}
    <div class="garde-layout">
    {# ───────── Calendrier mensuel ───────── #}
    <section class="card garde-cal-card">
        <div class="garde-cal__nav">
            <strong class="garde-cal__title">{{ monthLabel }}</strong>
            <div class="garde-cal__nav-actions">
                {# La légende porte le marqueur lui-même, pas seulement la couleur : sans lui elle
                   n'explique rien à qui ne distingue pas les deux teintes. #}
                <div class="garde-legend">
                    <span><i class="garde-dot garde-dot--a" aria-hidden="true">{{ pAInitial }}</i> {{ pAName }}</span>
                    <span><i class="garde-dot garde-dot--b" aria-hidden="true">{{ pBInitial }}</i> {{ pBName }}</span>
                </div>
                <a class="garde-cal__nav-btn" href="{{ path('app_garde', { month: prevMonth }) }}" aria-label="Mois précédent">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                </a>
                <a class="garde-cal__nav-btn" href="{{ path('app_garde', { month: nextMonth }) }}" aria-label="Mois suivant">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                </a>
            </div>
        </div>
        <div class="garde-cal">
            {% for d in ['Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi','Dimanche'] %}<div class="garde-cal__dow">{{ d }}</div>{% endfor %}
            {% for week in weeks %}
                {% for cell in week %}
                    {% set cellEvents = dayEvents[cell.date]|default([]) %}
                    <div class="garde-day garde-day--{{ cell.slot == 'A' ? 'a' : (cell.slot == 'B' ? 'b' : 'none') }}
                                {{ cell.source == 'exception' ? 'garde-day--exception' }}
                                {{ cell.isToday and cell.inMonth ? 'garde-day--today' }}
                                {{ not cell.inMonth ? 'garde-day--out' }}"
                         {% if cell.inMonth %}
                            {# Le clic ouvre la FICHE DU JOUR (US-CUST-6) et non plus l'échange direct :
                               une case portait auparavant un `swapDay` qui réattribuait durablement un
                               jour de garde derrière un simple `confirm()`, et le droit `custody=view`
                               n'avait aucune interaction. « Échanger ce jour » vit désormais dans la
                               fiche, sous `custody=edit`, comme la maquette le prescrit (`:862`). #}
                            data-action="click->garde#openDay keydown.enter->garde#openDay keydown.space->garde#openDay"
                            data-day-url="{{ path('app_garde_day', { date: cell.date }) }}"
                            role="button" tabindex="0" title="Voir le détail de ce jour"
                            aria-label="{{ cell.date|date('d/m/Y') }}{% if cell.slot %} — chez {{ cell.slot == 'A' ? pAName : pBName }}{% endif %}{{ cell.source == 'exception' ? ' (exception)' }}{{ cell.source == 'holiday' ? ' (vacances scolaires)' }}{% if cellEvents is not empty %} · {{ cellEvents|length }} activité{{ cellEvents|length > 1 ? 's' : '' }}{% endif %}. Voir le détail de ce jour."
                         {% endif %}>
                        <span class="garde-day__num">{{ cell.day }}</span>
                        {# ── Pastilles d'activité de la famille (maquette `:236-238`) ──
                           `aria-hidden` : le nombre d'activités figure déjà dans l'aria-label de la
                           case, et le détail dans la fiche qu'elle ouvre — sans quoi un lecteur
                           d'écran énoncerait deux fois la même liste tronquée. #}
                        {% if cellEvents is not empty %}
                        <div class="garde-day__events" aria-hidden="true">
                            {% for ev in cellEvents|slice(0, eventsPerCell) %}
                                <span class="garde-day__event">
                                    <i class="garde-day__event-dot garde-day__event-dot--{{ catClass[ev.category]|default('other') }}"></i>
                                    <span class="garde-day__event-title">{{ ev.title }}</span>
                                </span>
                            {% endfor %}
                            {% if cellEvents|length > eventsPerCell %}
                                <span class="garde-day__more">+{{ cellEvents|length - eventsPerCell }}</span>
                            {% endif %}
                        </div>
                        {% endif %}
                        {# Marqueur non chromatique de l'attribution (cdc §8) : les fonds A/B ne
                           diffèrent que par la teinte (1,12:1 de luminance), donc l'initiale est le
                           seul canal qui survit au niveaux de gris, au daltonisme rouge-vert et à
                           `forced-colors`. Masqué aux lecteurs d'écran, qui reçoivent le nom en
                           clair — via l'aria-label de la case échangeable, ou le `.sr-only`. #}
                        {% if cell.slot %}
                            <span class="garde-day__parent" aria-hidden="true">{{ cell.slot == 'A' ? pAInitial : pBInitial }}</span>
                            {# Les cases du mois portent le nom dans leur aria-label ; celles des mois
                               voisins ne sont pas des boutons et ont donc besoin du texte caché. #}
                            {% if not cell.inMonth %}
                                <span class="sr-only">chez {{ cell.slot == 'A' ? pAName : pBName }}</span>
                            {% endif %}
                        {% endif %}
                        {% if cell.source == 'holiday' %}<span class="garde-day__tag">vac.</span>{% endif %}
                        {% if overlayBadges is defined and overlayBadges[cell.date] is defined %}<span class="garde-day__overlay" title="Famille liée"></span>{% endif %}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    </section>

    <aside class="garde-aside">
        {# ───────── Statistiques ───────── #}
        <section class="card">
            <div class="eyebrow">Statistiques du mois</div>
            <div class="garde-stats">
                <div class="garde-stat garde-stat--a">
                    <strong>{{ stats.parentACount }}</strong>
                    <span>{{ pAName }} · {{ stats.pctA }} %</span>
                </div>
                <div class="garde-stat garde-stat--b">
                    <strong>{{ stats.parentBCount }}</strong>
                    <span>{{ pBName }} · {{ stats.pctB }} %</span>
                </div>
            </div>
            {# Le moteur ne génère pas le passé (ni au-delà de l'horizon glissant) : un mois peut
               n'être couvert qu'en partie. Les pourcentages étaient alors présentés comme ceux du
               mois entier — « 66,7 % / 33,3 % » sur 6 jours matérialisés sur 31 (revue C19). #}
            {% if stats.total < stats.daysInWindow %}
            <p class="form-note">Calculé sur les {{ stats.total }} jour{{ stats.total > 1 ? 's' : '' }} déjà planifiés de ce mois (sur {{ stats.daysInWindow }}).</p>
            {% endif %}
        </section>

        {# ───────── Périodes spéciales du mois affiché ─────────
           Ne liste que les périodes qui CHEVAUCHENT le mois affiché : le panneau jouxte
           « Statistiques du mois », et lister tout l'historique de la famille y faisait apparaître
           des vacances déjà passées (l'import ramène l'année scolaire entière).
           Les dates portent leur année : « 18/10→02/11 » était ambigu à un an près.
           La barre A/B décorative a été retirée : deux `flex: 1` donnaient TOUJOURS un 50/50, ce qui
           laissait croire à un partage défini là où aucune règle n'existait, et contredisait une
           exception attribuée en entier à un seul parent. #}
        {% if exceptions|length or holidays|length %}
        <section class="card">
            <div class="eyebrow">Périodes spéciales du mois</div>
            <div class="garde-special">
                {% for e in exceptions %}
                <div class="garde-special__item">
                    <div class="garde-special__head">
                        <span class="garde-special__title">Exception{% if e.reason %} · {{ e.reason }}{% endif %}</span>
                        <span class="garde-special__dates">{{ e.startDate|date('d/m/Y') }}→{{ e.endDate|date('d/m/Y') }}</span>
                    </div>
                    <div class="garde-special__rule">
                        Chez {{ e.parentMembership ? (e.parentMembership.user.fullName ?: e.parentMembership.user.email) : '—' }}
                    </div>
                </div>
                {% endfor %}
                {% for h in holidays %}
                <div class="garde-special__item">
                    <div class="garde-special__head">
                        <span class="garde-special__title">{{ h.label }}</span>
                        <span class="garde-special__dates">{{ h.startDate|date('d/m/Y') }}→{{ h.endDate|date('d/m/Y') }}</span>
                    </div>
                    <div class="garde-special__rule">
                        {% if h.rule %}
                            {{ holidayRuleLabel[h.rule.kind.value] ?? h.rule.kind.value }}
                        {% else %}
                            <span class="garde-special__norule">Aucune règle de partage — le rythme habituel s'applique</span>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
        </section>
        {% endif %}
    </aside>
    </div>
    {% endif %}

    {# ───────── Fiche de jour (US-CUST-6) ─────────
       `<dialog>` natif plutôt qu'une surcouche maison : le navigateur fournit le fond modal, le
       piège à focus, la restauration du focus à la fermeture et la touche Échap — tout ce qu'une
       modale en `<div>` doit réimplémenter, souvent mal.

       Le contenu est chargé **à la demande** dans le `<turbo-frame>` : rendre les 28 à 31 fiches du
       mois dans la page aurait multiplié son poids et fait calculer 31 fois la transmission et les
       activités pour un jour consulté. Le fragment étant inséré dans la portée du contrôleur
       `garde`, ses propres `data-action` (fermeture, « Échanger ce jour ») sont câblés par Stimulus
       sans code supplémentaire. #}
    <dialog class="day-modal" data-garde-target="dayDialog" aria-labelledby="garde-day-title"
            data-action="click->garde#dayBackdrop">
        <turbo-frame id="garde-day" data-garde-target="dayFrame">
            <p class="day-modal__loading">Chargement…</p>
        </turbo-frame>
    </dialog>

    {# La configuration du rythme, les exceptions et les vacances vivent désormais dans
       Paramètres › Rythme de garde (édition), pour garder cet écran centré sur la consultation. #}
</div>
{% endif %}
{% endblock %}
