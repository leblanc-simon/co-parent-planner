{% extends 'app/shell.html.twig' %}
{% block title %}Accueil · CoParentPlanner{% endblock %}

{% set catClass = {'sport':'sport','musique':'music','ecole':'school','sante':'health','autre':'other'} %}
{% set catLabel = {'sport':'Sport','musique':'Musique','ecole':'École','sante':'Santé','autre':'Autre'} %}
{% set dowFr = {'0':'DIM','1':'LUN','2':'MAR','3':'MER','4':'JEU','5':'VEN','6':'SAM'} %}

{% block main %}
<header class="main__header">
    <div>
        <div class="eyebrow">{{ "now"|date("d/m/Y", timezone) }}</div>
        <h1>Bonjour {{ user.fullName ?: user.email }}</h1>
    </div>
    {# Proposé au seul membre qui peut effectivement créer : avec `agenda: view`, le formulaire de
       l'écran Agenda n'est pas rendu, et l'invitation ne menait donc nulle part (revue 6.12). #}
    {% if can('agenda', 'edit') %}
    <div class="main__header-actions">
        <a class="btn btn--ink" href="{{ path('app_agenda') }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            Nouvel événement
        </a>
    </div>
    {% endif %}
</header>

<div class="home-grid">
    <div class="home-col">
        {# Carte masquée à qui n'a pas le domaine `custody` : elle annonçait « Le planning de garde
           s'affichera ici. » à un membre qui n'aura JAMAIS ce droit — une promesse que rien ne
           tiendra jamais (revue 6.12). L'information « famille unie » n'est pas un droit et reste
           donc affichée. #}
        {% if not activeMembership.family.hasCustody or can('custody') %}
        {# Liseré gauche de la couleur de garde du JOUR (maquette :114) : constant jusqu'ici, il
           désignait le parent A une semaine sur deux à celui qui avait pourtant les enfants. #}
        <section class="card card--accent home-hero home-hero--{{ custody.todaySlot|default('none')|lower }}">
            <div class="home-hero__head">
                <div class="eyebrow">{{ activeMembership.family.hasCustody ? 'Garde · cette semaine' : 'Cette semaine' }}</div>
                {% if heroChildren|length %}
                <div class="home-hero__kids" aria-hidden="true">
                    {% for child in heroChildren %}
                    <span class="home-hero__kid" style="background: {{ child.color }}">{{ child.firstName|first|upper }}</span>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
            {% if not activeMembership.family.hasCustody %}
                <p class="home-hero__text">Toute la famille est réunie.</p>
            {% elseif custody and custody.cells|filter(c => c.slot)|length %}
                {# La phrase que l'accueil n'énonçait pas : chez qui sont les enfants, et quand ils
                   changent de foyer (constat 6.5, maquette :123-127). #}
                {% if custody.todaySlot %}
                <p class="home-hero__text">
                    {{ custody.isViewerDay
                        ? 'Les enfants sont avec vous cette semaine.'
                        : 'Les enfants sont chez ' ~ custody.names[custody.todaySlot] ~ ' cette semaine.' }}
                </p>
                {% endif %}
                {% if custody.handover %}
                <p class="home-hero__sub">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/></svg>
                    {{ custody.handover.isViewer ? 'De retour chez vous' : 'Retour chez ' ~ custody.handover.name }}
                    {{ custody.handover.dateLabel }}{% if custody.handover.time %}, {{ custody.handover.time }}{% endif %}
                </p>
                {% endif %}
                <div class="garde-legend home-custody__legend">
                    <span><i class="garde-dot garde-dot--a" aria-hidden="true">{{ custody.initials.A }}</i> {{ custody.names.A }}</span>
                    <span><i class="garde-dot garde-dot--b" aria-hidden="true">{{ custody.initials.B }}</i> {{ custody.names.B }}</span>
                </div>
                <div class="home-custody">
                    {% for cell in custody.cells %}
                    <div class="home-custody__day home-custody__day--{{ cell.slot == 'A' ? 'a' : (cell.slot == 'B' ? 'b' : 'none') }}{{ cell.isToday ? ' is-today' }}">
                        <span class="home-custody__dow">{{ dowFr[cell.dow] }}</span>
                        <span class="home-custody__num">{{ cell.day }}</span>
                        {# Même marqueur non chromatique que /garde (cdc §8) : les deux fonds de cette
                           mini-semaine ne se distinguaient que par la teinte, à 1,09:1. #}
                        {% if cell.slot %}
                            <span class="home-custody__parent" aria-hidden="true">{{ cell.slot == 'A' ? custody.initials.A : custody.initials.B }}</span>
                            <span class="sr-only">chez {{ cell.slot == 'A' ? custody.names.A : custody.names.B }}</span>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
                <a class="section-head__link" href="{{ path('app_garde') }}">Planning complet →</a>
            {% else %}
                {# Ici le droit est acquis : la promesse est tenable, on donne l'action qui la tient. #}
                <p class="empty-state">Le planning de garde s'affichera ici.</p>
                {% if can('custody', 'edit') %}
                    <a class="section-head__link" href="{{ path('app_settings', {tab: 'garde'}) }}#sec-custody">Configurer le rythme de garde →</a>
                {% endif %}
            {% endif %}
        </section>
        {% endif %}

        <section>
            <div class="section-head">
                <div class="eyebrow">À venir</div>
                <a class="section-head__link" href="{{ path('app_agenda') }}">Tout l'agenda →</a>
            </div>
            {% if upcoming|length %}
                <ul class="agenda-upcoming">
                    {% for occ in upcoming %}
                    <li>
                        <span class="up-date">
                            <span class="up-date__dow">{{ dowFr[occ.startsAt|date('w', timezone)] }}</span>
                            <span class="up-date__num">{{ occ.startsAt|date('j', timezone) }}</span>
                        </span>
                        <span class="up-sep"></span>
                        <span class="up-body">
                            <strong class="up-title">{{ occ.title }}</strong>
                            <span class="up-meta">{% if occ.allDay %}Journée{% else %}{{ occ.startsAt|date('H:i', timezone) }}{% endif %}</span>
                        </span>
                        <span class="pill pill--{{ catClass[occ.category.value] }} up-pill">{{ catLabel[occ.category.value] }}</span>
                    </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="empty-state">Aucun événement à venir.</p>
            {% endif %}
        </section>
    </div>

    <div class="home-col">
        <section class="card">
            <div class="section-head">
                <div class="eyebrow">À décider ensemble</div>
                {% if homeExchanges|length %}<a class="section-head__link" href="{{ path('app_echanges') }}">Tous les échanges →</a>{% endif %}
            </div>
            {% if homeExchanges|length %}
                <div class="home-stack">
                    {% for ex in homeExchanges %}
                    <a class="exchange-card" href="{{ path('app_echanges', { exchange: ex.id }) }}">
                        <div class="exchange-card__head">
                            <span class="exchange-tag exchange-tag--{{ ex.type }}">{{ ex.type == 'decision' ? 'Décision' : 'Discussion' }}</span>
                            {% if ex.overdue %}<span class="exchange-tag exchange-tag--overdue">En retard</span>{% endif %}
                        </div>
                        <strong class="exchange-card__title">{{ ex.title }}</strong>
                        <div class="exchange-card__meta">
                            {{ ex.childId ? 'Un enfant' : 'Toute la famille' }} · {{ ex.messageCount }} message{{ ex.messageCount > 1 ? 's' }}{% if ex.deadline %} · échéance {{ ex.deadline|date('d/m/Y') }}{% endif %}
                        </div>
                    </a>
                    {% endfor %}
                </div>
            {% else %}
                <p class="empty-state">Aucun échange ouvert.</p>
            {% endif %}
        </section>
        <section class="card">
            <div class="section-head">
                <div class="eyebrow">Dernières notes</div>
                {% if recentNotes|length %}<a class="section-head__link" href="{{ path('app_children') }}">Toutes les notes →</a>{% endif %}
            </div>
            {% if recentNotes|length %}
                <ul class="notes">
                    {% for note in recentNotes %}
                    <li class="note-item">
                        <span class="avatar avatar--22" style="background: {{ note.authorColor ?: '#C2643D' }}">{{ note.authorName|first|upper }}</span>
                        <div class="note-item__body">
                            <div class="note-item__meta">
                                <strong>{{ note.authorName }}</strong>
                                <span class="note-item__child">sur {{ note.childName }}</span>
                                <time datetime="{{ note.date|date('Y-m-d') }}">{{ note.date|date('d/m') }}</time>
                            </div>
                            <p class="note-item__text">{{ note.text }}</p>
                        </div>
                    </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="empty-state">Aucune note pour le moment.</p>
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}
