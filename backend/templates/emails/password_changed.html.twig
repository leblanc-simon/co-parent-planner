<!DOCTYPE html>
<html lang="{{ locale }}">
<body style="font-family: Arial, sans-serif; color: #292621; background: #E5E0D6; padding: 24px;">
    <div style="max-width: 520px; margin: 0 auto; background: #F4F1EA; border-radius: 16px; padding: 28px;">
        <h1 style="font-size: 20px; color: #C2643D;">{{ 'email.password_changed.title'|trans({}, 'messages', locale) }}</h1>
        <p>{{ 'email.password_changed.body'|trans({}, 'messages', locale) }}</p>
        <p style="font-size: 13px; color: #857E71;">{{ 'email.password_changed.warning'|trans({}, 'messages', locale) }}</p>
    </div>
</body>
</html>
