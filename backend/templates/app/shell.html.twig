{% extends 'base.html.twig' %}

{% block body %}
<div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar__brand">🧡 CoParentPlanner</div>
        <nav class="sidebar__nav">
            {% set nav = nav_active|default('home') %}
            <a href="{{ path('app_home') }}" class="{{ nav == 'home' ? 'is-active' }}">Accueil</a>
            {# Onglet Garde masqué pour les familles unies (intact) — cdc §2.4. #}
            {% if activeMembership is defined and activeMembership.family.hasCustody %}
                <a href="{{ path('app_garde') }}" class="{{ nav == 'garde' ? 'is-active' }}">Garde</a>
            {% endif %}
            <a href="{{ path('app_agenda') }}" class="{{ nav == 'agenda' ? 'is-active' }}">Agenda</a>
            <a href="{{ path('app_children') }}" class="{{ nav == 'children' ? 'is-active' }}">Enfants</a>
            <a href="{{ path('app_settings') }}" class="{{ nav == 'settings' ? 'is-active' }}">Paramètres</a>
            {# Onglet Échanges ajouté au Lot 6. #}
        </nav>
        <div class="sidebar__spacer"></div>
        <form action="{{ path('app_logout') }}" method="post">
            <button class="btn btn--ghost btn--block" type="submit">Se déconnecter</button>
        </form>
    </aside>
    <main class="main">
        {% block main %}{% endblock %}
    </main>
</div>
{% endblock %}
