<div class="family-select" data-controller="family-select">
    {# Le menu n'annonçait rien : ni son état, ni sa nature, et Échap ne le fermait pas — il fallait
       cliquer ailleurs, geste qu'un utilisateur au clavier n'a pas. #}
    <button class="family-select__button" type="button" data-action="family-select#toggle"
            data-family-select-target="button" aria-haspopup="true" aria-expanded="false">
        <span class="family-select__tag">{{ activeMembership.family.name|first|upper }}</span>
        <span class="family-select__label">{{ activeMembership.family.name }}</span>
        <svg class="family-select__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 9l4-4 4 4M16 15l-4 4-4-4"/></svg>
    </button>
    <div class="family-select__menu" data-family-select-target="menu" role="menu" hidden>
        {% for m in memberships %}
            <button type="button" role="menuitem" class="family-select__item {{ m.id == activeMembership.id ? 'is-active' }}"
                    data-action="family-select#select" data-family-id="{{ m.family.id }}"
                    {{ m.id == activeMembership.id ? 'aria-current="true"' : '' }}>
                {{ m.family.name }}
                <small>{{ {'parent':'Parent','step_parent':'Beau-parent','child':'Enfant'}[m.role.value] ?? m.role.value }}{{ m.isAdmin ? ' · admin' }}</small>
            </button>
        {% endfor %}
        {# Créer une seconde famille était impossible depuis l'interface : `/onboarding`
           répondait 200 mais aucun gabarit n'y menait, et ce menu n'offrait aucune
           action (revue web 2026-07, constat 6.10). Rejoindre une famille reste
           nominatif — cela passe par le lien d'invitation reçu par e-mail. #}
        <a class="family-select__action" role="menuitem" href="{{ path('app_onboarding') }}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            Créer une famille
        </a>
    </div>
</div>
