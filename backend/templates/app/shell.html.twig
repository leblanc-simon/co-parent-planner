{% extends 'base.html.twig' %}

{% block body %}
<div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar__brand">
            <span class="sidebar__logo" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            CoParentPlanner
        </div>

        {% if activeMembership is defined %}
        <div class="sidebar__switcher">{{ include('app/_family_select.html.twig') }}</div>
        {% endif %}

        <div class="sidebar__eyebrow">Navigation</div>
        <nav class="sidebar__nav">
            {% set nav = nav_active|default('home') %}
            <a href="{{ path('app_home') }}" class="{{ nav == 'home' ? 'is-active' }}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
                Accueil
            </a>
            {# Onglet Garde masqué pour les familles unies (intact) — cdc §2.4. #}
            {% if activeMembership is defined and activeMembership.family.hasCustody %}
                <a href="{{ path('app_garde') }}" class="{{ nav == 'garde' ? 'is-active' }}">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                    Garde
                </a>
            {% endif %}
            <a href="{{ path('app_agenda') }}" class="{{ nav == 'agenda' ? 'is-active' }}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
                Agenda
            </a>
            <a href="{{ path('app_children') }}" class="{{ nav == 'children' ? 'is-active' }}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="4"/><path d="M2 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2M17 11l2 2 4-4"/></svg>
                Enfants
            </a>
            {% set openExchanges = exchanges_open_count() %}
            {% if openExchanges is not null %}
            <a href="{{ path('app_echanges') }}" class="{{ nav == 'echanges' ? 'is-active' }}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                Échanges
                <span class="nav-badge" id="exchanges-badge"{% if openExchanges == 0 %} hidden{% endif %}>{{ openExchanges > 9 ? '9+' : openExchanges }}</span>
            </a>
            {% endif %}
            <a href="{{ path('app_settings') }}" class="{{ nav == 'settings' ? 'is-active' }}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                Paramètres
            </a>
            {# Onglet Échanges ajouté au Lot 6. #}
        </nav>
        <div class="sidebar__spacer"></div>

        {% if activeMembership is defined %}
        <div class="sidebar__profile">
            <a href="{{ path('app_settings') }}" class="sidebar__profile-main">
                <span class="avatar avatar--36" style="background: {{ activeMembership.displayColor ?: '#C2643D' }}">{{ (activeMembership.user.fullName ?: activeMembership.user.email)|first|upper }}</span>
                <span class="sidebar__profile-id">
                    <span class="sidebar__profile-name">{{ activeMembership.user.fullName ?: activeMembership.user.email }}</span>
                    <span class="sidebar__profile-role">{{ activeMembership.role.value }}</span>
                </span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            </a>
            <form action="{{ path('app_logout') }}" method="post">
                <button class="sidebar__logout" type="submit">Se déconnecter</button>
            </form>
        </div>
        {% else %}
        <form action="{{ path('app_logout') }}" method="post">
            <button class="btn btn--ghost btn--block" type="submit">Se déconnecter</button>
        </form>
        {% endif %}
    </aside>
    <main class="main">
        {% block main %}{% endblock %}
    </main>
</div>
{% endblock %}
